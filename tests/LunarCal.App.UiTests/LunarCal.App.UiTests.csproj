<Project Sdk="Microsoft.NET.Sdk">

  <!-- FlaUI smoke tests: launch the built LunarCal.exe and drive it through UI Automation (spec §9). -->
  <PropertyGroup>
    <TargetFramework>$(LunarCalWindowsTfm)</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build order only; tests run the app out-of-process. -->
    <ProjectReference Include="..\..\src\LunarCal.App\LunarCal.App.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>

</Project>
