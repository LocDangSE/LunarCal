<Project>

  <!-- Shared build settings for every project in the repo. See docs/DECISIONS.md. -->

  <PropertyGroup Label="Target frameworks">
    <!-- Core (pure domain, BCL only) stays OS-agnostic; everything touching Windows APIs uses the Windows TFM. ADR-0002 -->
    <LunarCalCoreTfm>net10.0</LunarCalCoreTfm>
    <LunarCalWindowsTfm>net10.0-windows10.0.19041.0</LunarCalWindowsTfm>
  </PropertyGroup>

  <PropertyGroup Label="Language and quality">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Label="Supply chain (SEC-SC-1, SEC-SC-4)">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- SourceLink reproducible build (SEC-SC-4) -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup Label="SourceLink (SEC-SC-4)">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <PropertyGroup Label="Product metadata">
    <!-- Product name LunarCal is final (ADR-0023); publisher/company name is still open (spec §14.1). -->
    <Product>LunarCal</Product>
    <Company>LunarCal</Company>
    <Copyright>Copyright © LunarCal contributors</Copyright>
    <Version>0.1.0</Version>
    <NeutralLanguage>vi-VN</NeutralLanguage>
  </PropertyGroup>

</Project>
