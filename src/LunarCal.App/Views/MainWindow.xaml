<Window x:Class="LunarCal.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LunarCal.App.ViewModels"
        xmlns:views="clr-namespace:LunarCal.App.Views"
        xmlns:controls="clr-namespace:LunarCal.App.Controls"
        xmlns:loc="clr-namespace:LunarCal.App.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="LunarCal"
        AutomationProperties.AutomationId="MainWindow"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

  <DockPanel LastChildFill="True">
    <!-- Top Bar (FR-UI-9) -->
    <controls:TopBar DockPanel.Dock="Top" DataContext="{Binding}" />

    <!-- Sidebar (FR-UI-10) -->
    <controls:Sidebar DockPanel.Dock="Left" DataContext="{Binding}" />

    <!-- Main View Content Area -->
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
      <Grid.RowDefinitions>
        <!-- Center Calendar Viewport (Month/Week/Day/Agenda) -->
        <RowDefinition Height="*" />
        <!-- Bottom AI Command Bar Placeholder (FR-UI-5, Figma 01) -->
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Calendar View Area (FR-UI-1, FR-UI-2, FR-LUNAR-6) -->
      <Border Grid.Row="0"
              Margin="16"
              Background="{DynamicResource SurfaceElevatedBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource CornerRadiusMedium}"
              ClipToBounds="True"
              AutomationProperties.AutomationId="MainViewContainer">
        <Grid>
          <!-- 6×7 Month View Grid -->
          <views:MonthView DataContext="{Binding MonthView}">
            <views:MonthView.Style>
              <Style TargetType="views:MonthView">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DataContext.ActiveViewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Month">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </views:MonthView.Style>
          </views:MonthView>

          <!-- 7-Day Week View Grid (Figma S06, FR-UI-1) -->
          <views:WeekView DataContext="{Binding WeekView}">
            <views:WeekView.Style>
              <Style TargetType="views:WeekView">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DataContext.ActiveViewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Week">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </views:WeekView.Style>
          </views:WeekView>

          <!-- Single Day View Grid (Figma S07, FR-UI-1) -->
          <views:DayView DataContext="{Binding DayView}">
            <views:DayView.Style>
              <Style TargetType="views:DayView">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DataContext.ActiveViewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Day">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </views:DayView.Style>
          </views:DayView>

          <!-- Agenda (Schedule) View (Figma S08, FR-UI-1) -->
          <views:AgendaView DataContext="{Binding AgendaView}">
            <views:AgendaView.Style>
              <Style TargetType="views:AgendaView">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DataContext.ActiveViewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Agenda">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </views:AgendaView.Style>
          </views:AgendaView>
        </Grid>
      </Border>

      <!-- AI Command Bar Placeholder (FR-UI-5, Figma 01) -->
      <Border Grid.Row="1"
              Height="{DynamicResource AiCommandBarHeight}"
              Margin="16,0,16,16"
              Background="{DynamicResource SurfaceElevatedBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource CornerRadiusAiBar}"
              Padding="16,0"
              AutomationProperties.AutomationId="AiCommandBar">
        <Grid VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- AI Sparkle Icon -->
          <TextBlock Grid.Column="0"
                     Text="✨"
                     FontSize="{DynamicResource IconSizeMedium}"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center" />

          <!-- Prompt Placeholder -->
          <TextBlock Grid.Column="1"
                     Text="{loc:Loc Key=ai.command_placeholder}"
                     FontSize="{DynamicResource FontSizeBody}"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     VerticalAlignment="Center" />

          <!-- Send Action Button -->
          <Border Grid.Column="2"
                  Width="28" Height="28"
                  CornerRadius="{DynamicResource CornerRadiusFull}"
                  Background="{DynamicResource AccentPrimaryBrush}"
                  Cursor="Hand"
                  AutomationProperties.AutomationId="BtnAiSubmit">
            <TextBlock Text="↑"
                       Foreground="{DynamicResource AccentTextBrush}"
                       FontWeight="{DynamicResource FontWeightBold}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
