<Window x:Class="LunarCal.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LunarCal.App.ViewModels"
        xmlns:views="clr-namespace:LunarCal.App.Views"
        xmlns:controls="clr-namespace:LunarCal.App.Controls"
        xmlns:loc="clr-namespace:LunarCal.App.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="LunarCal"
        AutomationProperties.AutomationId="MainWindow"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource FontFamilyBase}"
        Background="{DynamicResource WindowBackgroundBrush}">

  <!-- Figma 01 (1:2): full-height sidebar (1:3) on the left; the main column (1:196) holds the top bar, the
       calendar body and the AI command bar. -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Calendar body (FR-UI-1, FR-UI-2, FR-LUNAR-6) -->
      <Grid Grid.Row="1"
            Background="{DynamicResource WindowBackgroundBrush}"
            ClipToBounds="True"
            AutomationProperties.AutomationId="MainViewContainer">
        <views:MonthView DataContext="{Binding MonthView}">
          <views:MonthView.Style>
            <Style TargetType="views:MonthView">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.ActiveViewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Month">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </views:MonthView.Style>
        </views:MonthView>

        <views:WeekView DataContext="{Binding WeekView}">
          <views:WeekView.Style>
            <Style TargetType="views:WeekView">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.ActiveViewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Week">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </views:WeekView.Style>
        </views:WeekView>

        <views:DayView DataContext="{Binding DayView}">
          <views:DayView.Style>
            <Style TargetType="views:DayView">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.ActiveViewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Day">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </views:DayView.Style>
        </views:DayView>

        <views:AgendaView DataContext="{Binding AgendaView}">
          <views:AgendaView.Style>
            <Style TargetType="views:AgendaView">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.ActiveViewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Agenda">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </views:AgendaView.Style>
        </views:AgendaView>
      </Grid>

      <!-- AI command bar (Figma 1:198, FR-UI-5) -->
      <controls:AiCommandBar Grid.Row="2" DataContext="{Binding AiCommandBar}" />
      
      <!-- Top bar and status banners (Figma 1:197, S18, FR-UI-9) -->
      <StackPanel Grid.Row="0">
        <controls:TopBar DataContext="{Binding}" />

        <!-- Offline Banner (Figma S18, FR-UI-9) -->
        <Border Background="{DynamicResource WarningSubtleBrush}"
                BorderBrush="{DynamicResource WarningBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8"
                AutomationProperties.AutomationId="OfflineBanner">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsOfflineBannerVisible}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Command="{Binding DismissOfflineBannerCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4"
                    Cursor="Hand"
                    Margin="8,0,0,0"
                    AutomationProperties.AutomationId="BtnDismissOfflineBanner">
              <Path Data="{DynamicResource IconClose32}"
                    Stroke="{DynamicResource WarningTextBrush}"
                    StrokeThickness="1.5"
                    Width="12" Height="12" />
            </Button>
            <Button DockPanel.Dock="Right"
                    Command="{Binding SyncNowCommand}"
                    Content="{loc:Loc Key=sidebar.sync_now}"
                    Padding="12,4"
                    FontSize="{DynamicResource FontSizeCaption}"
                    FontWeight="{DynamicResource FontWeightSemiBold}"
                    Foreground="{DynamicResource WarningTextBrush}"
                    Background="Transparent"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="1"
                    Cursor="Hand"
                    AutomationProperties.AutomationId="BtnRetrySync" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="{loc:Loc Key=banner.offline}"
                         FontSize="{DynamicResource FontSizeBody}"
                         FontWeight="{DynamicResource FontWeightMedium}"
                         Foreground="{DynamicResource WarningTextBrush}"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Re-auth Banner (Figma S14, S18, FR-AUTH-3, FR-AUTH-6) -->
        <Border Background="{DynamicResource WarningSubtleBrush}"
                BorderBrush="{DynamicResource WarningBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8"
                AutomationProperties.AutomationId="ReauthBanner">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsReauthBannerVisible}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Command="{Binding DismissReauthBannerCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4"
                    Cursor="Hand"
                    Margin="8,0,0,0"
                    AutomationProperties.AutomationId="BtnDismissReauthBanner">
              <Path Data="{DynamicResource IconClose32}"
                    Stroke="{DynamicResource WarningTextBrush}"
                    StrokeThickness="1.5"
                    Width="12" Height="12" />
            </Button>
            <Button DockPanel.Dock="Right"
                    Command="{Binding ReauthCommand}"
                    Content="{loc:Loc Key=banner.btn_reauth}"
                    Padding="12,4"
                    FontSize="{DynamicResource FontSizeCaption}"
                    FontWeight="{DynamicResource FontWeightSemiBold}"
                    Foreground="{DynamicResource WarningTextBrush}"
                    Background="Transparent"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="1"
                    Cursor="Hand"
                    AutomationProperties.AutomationId="BtnBannerReauth" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="{loc:Loc Key=banner.reauth}"
                         FontSize="{DynamicResource FontSizeBody}"
                         FontWeight="{DynamicResource FontWeightMedium}"
                         Foreground="{DynamicResource WarningTextBrush}"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Sidebar (Figma 1:3, FR-UI-10), drawn last so its shadow falls on the main column -->
    <controls:Sidebar Grid.Column="0" DataContext="{Binding}" />

    <!-- Scrim overlay when AiQueueDrawer is open (Figma 03) -->
    <Border Grid.Column="1"
            Background="{DynamicResource ScrimBrush}"
            Focusable="False">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding AiQueueDrawer.IsOpen}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Border.InputBindings>
        <MouseBinding MouseAction="LeftClick" Command="{Binding CloseAiQueueDrawerCommand}" />
      </Border.InputBindings>
    </Border>

    <!-- AI Queue Drawer (Figma 03, FR-QUEUE-2, FR-QUEUE-6) -->
    <views:AiQueueDrawer Grid.Column="1"
                         DataContext="{Binding AiQueueDrawer}"
                         HorizontalAlignment="Right">
      <views:AiQueueDrawer.Style>
        <Style TargetType="views:AiQueueDrawer">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsOpen}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </views:AiQueueDrawer.Style>
    </views:AiQueueDrawer>
  </Grid>
</Window>
