<Window x:Class="LunarCal.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LunarCal.App.ViewModels"
        xmlns:settings="clr-namespace:LunarCal.App.Views.Settings"
        xmlns:conv="clr-namespace:LunarCal.App.Converters"
        xmlns:loc="clr-namespace:LunarCal.App.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="{loc:Loc Key=topbar.settings}"
        AutomationProperties.AutomationId="SettingsWindow"
        Width="840" Height="680"
        MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource FontFamilyBase}"
        Background="{DynamicResource WindowBackgroundBrush}">

  <Window.Resources>
    <x:Static x:Key="Loc" Member="loc:LocalizationService.Instance" />
    <conv:EnumToBooleanConverter x:Key="EnumToBool" />

    <!-- Sidebar Navigation Button Style -->
    <Style x:Key="SettingsNavButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{DynamicResource CornerRadiusMedium}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
              </Trigger>
              <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <!-- Navigation Sidebar (Figma 04 4:3) -->
      <ColumnDefinition Width="220" />
      <!-- Content Area -->
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Navigation Column -->
    <Border Grid.Column="0"
            Background="{DynamicResource SurfaceBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="16,24,16,16">
      <StackPanel>
        <TextBlock Text="{Binding [topbar.settings], Source={StaticResource Loc}}"
                   FontSize="{DynamicResource FontSizeTitle}"
                   FontWeight="{DynamicResource FontWeightBold}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="12,0,0,20" />

        <!-- Tab 1: Appearance (S13) -->
        <Button Style="{StaticResource SettingsNavButtonStyle}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:SettingsTab.Appearance}"
                Tag="{Binding ActiveTab, Converter={StaticResource EnumToBool}, ConverterParameter=Appearance}"
                AutomationProperties.AutomationId="NavAppearance">
          <TextBlock Text="{Binding [settings.nav.appearance], Source={StaticResource Loc}}"
                     FontSize="{DynamicResource FontSizeBody}"
                     FontWeight="{DynamicResource FontWeightMedium}"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </Button>

        <!-- Tab 2: Google Account (Figma 04) -->
        <Button Style="{StaticResource SettingsNavButtonStyle}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:SettingsTab.GoogleAccount}"
                Tag="{Binding ActiveTab, Converter={StaticResource EnumToBool}, ConverterParameter=GoogleAccount}"
                AutomationProperties.AutomationId="NavGoogleAccount">
          <TextBlock Text="{Binding [settings.nav.account], Source={StaticResource Loc}}"
                     FontSize="{DynamicResource FontSizeBody}"
                     FontWeight="{DynamicResource FontWeightMedium}"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </Button>

        <!-- Tab 3: Advanced (S20) -->
        <Button Style="{StaticResource SettingsNavButtonStyle}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:SettingsTab.Advanced}"
                Tag="{Binding ActiveTab, Converter={StaticResource EnumToBool}, ConverterParameter=Advanced}"
                AutomationProperties.AutomationId="NavAdvanced">
          <TextBlock Text="{Binding [settings.nav.advanced], Source={StaticResource Loc}}"
                     FontSize="{DynamicResource FontSizeBody}"
                     FontWeight="{DynamicResource FontWeightMedium}"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </Button>
      </StackPanel>
    </Border>

    <!-- Content Area Column -->
    <Grid Grid.Column="1">
      <!-- Appearance Page -->
      <ContentControl x:Name="AppearanceContent">
        <ContentControl.Style>
          <Style TargetType="ContentControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ActiveTab}" Value="{x:Static vm:SettingsTab.Appearance}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ContentControl.Style>
      </ContentControl>

      <!-- Google Account Page -->
      <ContentControl x:Name="AccountContent">
        <ContentControl.Style>
          <Style TargetType="ContentControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ActiveTab}" Value="{x:Static vm:SettingsTab.GoogleAccount}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ContentControl.Style>
      </ContentControl>

      <!-- Advanced Page -->
      <ContentControl x:Name="AdvancedContent">
        <ContentControl.Style>
          <Style TargetType="ContentControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ActiveTab}" Value="{x:Static vm:SettingsTab.Advanced}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ContentControl.Style>
      </ContentControl>
    </Grid>
  </Grid>
</Window>
