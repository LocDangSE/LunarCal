<UserControl x:Class="LunarCal.App.Views.WeekView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LunarCal.App.ViewModels"
             xmlns:conv="clr-namespace:LunarCal.App.Converters"
             xmlns:bhv="clr-namespace:LunarCal.App.Behaviors"
             xmlns:loc="clr-namespace:LunarCal.App.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WeekViewModel}"
             AutomationProperties.AutomationId="WeekView">

  <!-- Figma S06 week body (24:2): column header (24:3), all-day row (24:48), time grid (24:60). The hour gutter
       is 56 px, hours are 48 px, and every hour line sits 8 px below the label top so the first label is not cut. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:LaneMarginConverter x:Key="LaneMarginConverter" />
    <conv:LaneWidthConverter x:Key="LaneWidthConverter" />
    <conv:ColorToBrushConverter x:Key="ColorToBrush" />
  </UserControl.Resources>

  <Grid Background="{DynamicResource SurfaceBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Column header: gutter "GMT+7", then T2 … CN with the date and lunar day -->
    <Border Grid.Row="0"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            AutomationProperties.AutomationId="WeekHeadersBar">
      <Grid Height="64">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{DynamicResource HourGutterGridWidth}" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Same width as the grid's vertical scroll bar, so header columns line up with the time grid -->
        <FrameworkElement Grid.Column="2" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" />

        <TextBlock Grid.Column="0"
                   Text="{Binding TimeZoneLabel}"
                   Margin="0,0,0,6"
                   FontSize="{DynamicResource FontSizeMini}"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom" />

        <ItemsControl Grid.Column="1" ItemsSource="{Binding DayColumns}" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" Columns="7" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:DayColumnViewModel}">
              <StackPanel Margin="0,8,0,0"
                          HorizontalAlignment="Center"
                          AutomationProperties.AutomationId="WeekHeaderCell">
                <TextBlock Text="{Binding ShortDayName}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           FontWeight="{DynamicResource FontWeightSemiBold}"
                           HorizontalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                  <Border Width="30" Height="30" CornerRadius="{DynamicResource CornerRadiusFull}">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsToday}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding SolarDayString}"
                               FontSize="{DynamicResource FontSizeColumnDate}"
                               FontWeight="{DynamicResource FontWeightSemiBold}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>

                  <!-- Lunar day (FR-UI-2, FR-LUNAR-6) -->
                  <TextBlock Text="{Binding LunarDayText}"
                             Margin="6,0,0,0"
                             FontSize="{DynamicResource FontSizeCaption}"
                             Foreground="{DynamicResource LunarTextPrimaryBrush}"
                             VerticalAlignment="Center"
                             AutomationProperties.AutomationId="LunarDateText">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontWeight" Value="{DynamicResource FontWeightRegular}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsLunarHighlight}" Value="True">
                            <Setter Property="FontWeight" Value="{DynamicResource FontWeightSemiBold}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding LunarDayText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsLunarVisible}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <!-- All-day row: gutter "Cả ngày", cells with a left border, padding 4, min height 30 -->
    <Border Grid.Row="1"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            AutomationProperties.AutomationId="AllDayRow">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{DynamicResource HourGutterGridWidth}" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <FrameworkElement Grid.Column="2" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" />

        <TextBlock Grid.Column="0"
                   Text="{loc:Loc calendar.all_day}"
                   FontSize="{DynamicResource FontSizeMini}"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

        <ItemsControl Grid.Column="1" ItemsSource="{Binding DayColumns}" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" Columns="7" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:DayColumnViewModel}">
              <Border BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1,0,0,0"
                      Padding="4"
                      MinHeight="31">
                <ItemsControl ItemsSource="{Binding AllDayEvents}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:EventChipViewModel}">
                      <Border Margin="0,0,0,2"
                              Padding="{DynamicResource ThicknessPaddingEventChip}"
                              CornerRadius="{DynamicResource CornerRadiusSmall}"
                              Background="{Binding Background, Converter={StaticResource ColorToBrush}}"
                              ToolTip="{Binding Title}"
                              AutomationProperties.AutomationId="AllDayEventChip">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   FontWeight="{DynamicResource FontWeightMedium}"
                                   Foreground="{Binding Foreground, Converter={StaticResource ColorToBrush}}"
                                   TextTrimming="CharacterEllipsis" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <!-- Time grid, opened at 07:00 -->
    <ScrollViewer Grid.Row="2"
                  VerticalScrollBarVisibility="Visible"
                  HorizontalScrollBarVisibility="Disabled"
                  bhv:ScrollViewerBehavior.InitialVerticalOffset="{Binding InitialScrollOffset}"
                  AutomationProperties.AutomationId="WeekScrollViewer">
      <Grid Height="{DynamicResource TimeGridHeight}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{DynamicResource HourGutterGridWidth}" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Hour labels: 10 Regular tertiary, right edge at x = 48 -->
        <ItemsControl Grid.Column="0" ItemsSource="{Binding HourLabels}" Margin="0,2,8,0" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Height="{DynamicResource HourRowHeight}"
                         Text="{Binding}"
                         FontSize="{DynamicResource FontSizeMini}"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         TextAlignment="Right" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Hour lines -->
        <ItemsControl Grid.Column="1" ItemsSource="{Binding HourLabels}" Margin="0,8,0,0" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Height="{DynamicResource HourRowHeight}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="0,1,0,0" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Day columns: left line, today tint, events and the now line -->
        <ItemsControl Grid.Column="1" ItemsSource="{Binding DayColumns}" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" Columns="7" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:DayColumnViewModel}">
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsToday}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TodayColumnTintBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Canvas Margin="0,8,0,0">
                  <!-- The ItemsControl spans the column: inside a Canvas it would otherwise be 0 px wide and every
                       block would collapse to the minimum lane width (P2-R10). -->
                  <ItemsControl ItemsSource="{Binding TimedEvents}"
                                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                Focusable="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                        <Setter Property="Height" Value="{Binding Height}" />
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:TimedEventViewModel}">
                        <!-- Event block (24:98): 3 px stripe, radius 6, padding 4/6/4/8, title 11 SemiBold, time 10 at 80 % -->
                        <Grid Margin="0,1,0,1">
                        <Border Background="{Binding Background, Converter={StaticResource ColorToBrush}}"
                                BorderBrush="{Binding Color, Converter={StaticResource ColorToBrush}}"
                                BorderThickness="3,0,0,0"
                                CornerRadius="{DynamicResource CornerRadiusEventBlock}"
                                Padding="8,4,6,4"
                                ClipToBounds="True"
                                HorizontalAlignment="Left"
                                ToolTip="{Binding Title}"
                                AutomationProperties.AutomationId="TimedEventChip">
                          <Border.Width>
                            <MultiBinding Converter="{StaticResource LaneWidthConverter}">
                              <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Canvas}" />
                              <Binding Path="TotalColumns" />
                            </MultiBinding>
                          </Border.Width>
                          <Border.Margin>
                            <MultiBinding Converter="{StaticResource LaneMarginConverter}">
                              <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Canvas}" />
                              <Binding Path="ColumnIndex" />
                              <Binding Path="TotalColumns" />
                            </MultiBinding>
                          </Border.Margin>
                          <StackPanel>
                            <DockPanel>
                              <Path DockPanel.Dock="Left"
                                    Width="10" Height="10"
                                    Margin="0,0,4,0"
                                    Data="{DynamicResource IconSparkle10}"
                                    Fill="{Binding Foreground, Converter={StaticResource ColorToBrush}}"
                                    Stretch="None"
                                    VerticalAlignment="Top"
                                    Visibility="{Binding IsAi, Converter={StaticResource BoolToVis}}" />
                              <TextBlock Text="{Binding Title}"
                                         FontSize="{DynamicResource FontSizeCaption}"
                                         FontWeight="{DynamicResource FontWeightSemiBold}"
                                         Foreground="{Binding Foreground, Converter={StaticResource ColorToBrush}}"
                                         TextWrapping="Wrap"
                                         TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock Text="{Binding TimeRangeText}"
                                       Margin="0,1,0,0"
                                       FontSize="{DynamicResource FontSizeMini}"
                                       Foreground="{Binding Foreground, Converter={StaticResource ColorToBrush}}"
                                       Opacity="0.8"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Now line (24:119): 2 px across today's column, 10 px dot on the column line -->
                  <Grid Canvas.Top="{Binding NowIndicatorTop}"
                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                        Visibility="{Binding ShowNowIndicator, Converter={StaticResource BoolToVis}}"
                        Panel.ZIndex="100"
                        AutomationProperties.AutomationId="NowIndicator">
                    <Rectangle Height="2" Margin="0,-1,0,0" VerticalAlignment="Top" Fill="{DynamicResource NowLineBrush}" />
                    <Ellipse Width="10" Height="10"
                             Margin="-6,-5,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Fill="{DynamicResource NowLineBrush}" />
                  </Grid>
                </Canvas>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
