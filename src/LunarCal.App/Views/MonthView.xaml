<UserControl x:Class="LunarCal.App.Views.MonthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LunarCal.App.ViewModels"
             xmlns:conv="clr-namespace:LunarCal.App.Converters"
             xmlns:loc="clr-namespace:LunarCal.App.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MonthViewModel}"
             AutomationProperties.AutomationId="MonthView">

  <!-- Figma 01 month body: weekday header 36 px (1:229) and a 6×7 grid (1:244) whose 1 px gaps show the border
       colour. Cells: padding 8/8/6/8, 26 px day number, lunar day right, chips 19 px with a 4 px gap. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:ColorToBrushConverter x:Key="ColorToBrush" />

    <ContextMenu x:Key="EventContextMenu">
      <MenuItem Header="{loc:Loc menu.event.edit}" Click="OnEditEventClick" />
      <MenuItem Header="{loc:Loc menu.event.duplicate}" Click="OnDuplicateEventClick" />
      <MenuItem Header="{loc:Loc menu.event.convert_lunar}" Click="OnConvertLunarClick" />
      <Separator />
      <MenuItem Header="{loc:Loc menu.event.delete}" Click="OnDeleteEventClick" />
    </ContextMenu>

    <ContextMenu x:Key="SlotContextMenu">
      <MenuItem Header="{loc:Loc menu.slot.create_at}" Click="OnCreateEventAtClick" />
      <MenuItem Header="{loc:Loc menu.slot.create_all_day}" Click="OnCreateAllDayClick" />
      <MenuItem Header="{loc:Loc menu.slot.create_lunar}" Click="OnCreateLunarClick" />
      <Separator />
      <MenuItem Header="{loc:Loc menu.slot.paste}" Click="OnPasteClick" />
    </ContextMenu>
  </UserControl.Resources>

  <Grid Background="{DynamicResource SurfaceBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="{DynamicResource WeekdayHeaderGridHeight}" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Weekday header: "Thứ 2" … "Chủ nhật", 12 SemiBold #667085 -->
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            AutomationProperties.AutomationId="WeekdayHeadersBar">
      <ItemsControl ItemsSource="{Binding WeekdayHeaders}" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" Columns="7" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}"
                       FontSize="{DynamicResource FontSizeBody}"
                       FontWeight="{DynamicResource FontWeightSemiBold}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- Grid lines are the 1 px gaps between cells; the negative margin hides the gap after the last column/row -->
    <Border Grid.Row="1"
            Background="{DynamicResource BorderBrush}"
            ClipToBounds="True"
            AutomationProperties.AutomationId="MonthGridContainer">
      <ItemsControl ItemsSource="{Binding Days}" Margin="0,0,-1,-1" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="6" Columns="7" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:MonthDayViewModel}">
            <Border Margin="0,0,1,1"
                    Padding="{DynamicResource ThicknessPaddingMonthCell}"
                    Cursor="Hand"
                    ContextMenu="{StaticResource SlotContextMenu}"
                    ContextMenuOpening="OnSlotContextMenuOpening"
                    MouseLeftButtonDown="OnDayCellMouseLeftButtonDown"
                    AutomationProperties.AutomationId="DayCell">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                      <Setter Property="Background" Value="{DynamicResource CellOutsideMonthBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>

              <StackPanel>
                <!-- top: day number (26 px circle) + lunar day -->
                <Grid Height="26">
                  <Border Width="26" Height="26"
                          HorizontalAlignment="Left"
                          CornerRadius="{DynamicResource CornerRadiusDayNumber}">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsToday}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding SolarDayString}"
                               FontSize="{DynamicResource FontSizeBodyStrong}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                          <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                              <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                              <Setter Property="FontWeight" Value="{DynamicResource FontWeightSemiBold}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>

                  <TextBlock Text="{Binding LunarDayText}"
                             FontSize="{DynamicResource FontSizeCaption}"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsLunarVisible, Converter={StaticResource BoolToVis}}"
                             AutomationProperties.AutomationId="LunarDayLabel">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource LunarTextPrimaryBrush}" />
                        <Setter Property="FontWeight" Value="{DynamicResource FontWeightRegular}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsLunarHighlight}" Value="True">
                            <Setter Property="FontWeight" Value="{DynamicResource FontWeightSemiBold}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            <Setter Property="FontWeight" Value="{DynamicResource FontWeightRegular}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>

                <!-- Event chips (1:347): padding 3/6, radius 5, 11 Medium, calendar colours, gap 4 -->
                <ItemsControl ItemsSource="{Binding Chips}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:EventChipViewModel}">
                      <Border Margin="0,4,0,0"
                              Padding="{DynamicResource ThicknessPaddingEventChip}"
                              CornerRadius="{DynamicResource CornerRadiusSmall}"
                              Background="{Binding Background, Converter={StaticResource ColorToBrush}}"
                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                              ToolTip="{Binding Title}"
                              Focusable="True"
                              ContextMenu="{StaticResource EventContextMenu}"
                              ContextMenuOpening="OnEventContextMenuOpening"
                              MouseLeftButtonDown="OnEventChipMouseLeftButtonDown"
                              AutomationProperties.AutomationId="EventChip">
                        <DockPanel>
                          <Path DockPanel.Dock="Left"
                                Width="10" Height="10"
                                Margin="0,0,4,0"
                                Data="{DynamicResource IconSparkle10}"
                                Fill="{Binding Foreground, Converter={StaticResource ColorToBrush}}"
                                Stretch="None"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsAi, Converter={StaticResource BoolToVis}}" />
                          <TextBlock Text="{Binding Title}"
                                     FontSize="{DynamicResource FontSizeCaption}"
                                     FontWeight="{DynamicResource FontWeightMedium}"
                                     Foreground="{Binding Foreground, Converter={StaticResource ColorToBrush}}"
                                     TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding MoreEventsText}"
                           Margin="6,4,0,0"
                           FontSize="{DynamicResource FontSizeCaption}"
                           FontWeight="{DynamicResource FontWeightMedium}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding HasMoreEvents, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
  </Grid>
</UserControl>
