<UserControl x:Class="LunarCal.App.Views.AgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LunarCal.App.ViewModels"
             xmlns:conv="clr-namespace:LunarCal.App.Converters"
             xmlns:loc="clr-namespace:LunarCal.App.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AgendaViewModel}"
             AutomationProperties.AutomationId="AgendaView">

  <!-- Figma S08 agenda body (25:145): filter bar (25:146) and one card listing a row per day (25:162). -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:ColorToBrushConverter x:Key="ColorToBrush" />

    <!-- Filter chip (25:148): white, border #D0D5DD, pill, padding 5/12/5/10, dot 8 + 12 Medium; off = 50 % -->
    <Style x:Key="FilterChipStyle" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="chip"
                    Height="27"
                    Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusPill}"
                    Padding="10,0,12,0"
                    Opacity="0.5">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="chip" Property="Opacity" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Background="{DynamicResource WindowBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Filter bar: "Hiển thị:", chips (gap 8), summary -->
    <ScrollViewer Grid.Row="0"
                  Margin="24,16,24,16"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled"
                  AutomationProperties.AutomationId="CalendarFilterBar">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{loc:Loc agenda.filter_by}"
                   FontSize="{DynamicResource FontSizeBody}"
                   FontWeight="{DynamicResource FontWeightMedium}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center" />
        <ItemsControl ItemsSource="{Binding CalendarFilters}" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:CalendarFilterChipViewModel}">
              <ToggleButton IsChecked="{Binding IsSelected}"
                            Style="{StaticResource FilterChipStyle}"
                            AutomationProperties.Name="{Binding Summary}"
                            AutomationProperties.AutomationId="FilterChip">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="8" Height="8"
                           Fill="{Binding Color, Converter={StaticResource ColorToBrush}}"
                           VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Summary}"
                             Margin="6,0,0,0"
                             FontSize="{DynamicResource FontSizeBody}"
                             FontWeight="{DynamicResource FontWeightMedium}"
                             Foreground="{DynamicResource TextBodyBrush}"
                             VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding SummaryText}"
                   Margin="18,0,0,0"
                   FontSize="{DynamicResource FontSizeBody}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center"
                   AutomationProperties.AutomationId="AgendaSummaryText" />
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,0,24,16"
                  AutomationProperties.AutomationId="AgendaScrollViewer">
      <Grid>
        <!-- Empty state -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasEvents}" Value="False">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="{DynamicResource IconGlyphCalendar}"
                     FontFamily="{DynamicResource FontFamilyIcon}"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     FontSize="{DynamicResource IconSizeEmptyState}"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,12" />
          <TextBlock Text="{loc:Loc agenda.empty}"
                     FontSize="{DynamicResource FontSizeSubtitle}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Card (25:162): white, border, radius 12; one row per day with a bottom border -->
        <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CornerRadiusLarge}"
                VerticalAlignment="Top"
                Visibility="{Binding HasEvents, Converter={StaticResource BoolToVis}}">
          <ItemsControl ItemsSource="{Binding DayGroups}" Margin="0,0,0,-1" Focusable="False" Grid.IsSharedSizeScope="True">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:AgendaDayGroupViewModel}">
                <!-- Day row (25:163): padding 12/20, gap 20; today row tinted -->
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="20,12"
                        AutomationProperties.AutomationId="AgendaDayGroup">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="Transparent" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource TodayRowBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="180" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Date (25:164): 36 px badge + labels, gap 10 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Height="36">
                      <Border Width="36" Height="36" CornerRadius="{DynamicResource CornerRadiusFull}">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding DayNumberText}"
                                   FontSize="{DynamicResource FontSizeAgendaDate}"
                                   FontWeight="{DynamicResource FontWeightSemiBold}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>
                      <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DateLabel}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   FontWeight="{DynamicResource FontWeightSemiBold}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding LunarLabelText}"
                                   Margin="0,1,0,0"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource LunarTextPrimaryBrush}"
                                   Visibility="{Binding IsLunarVisible, Converter={StaticResource BoolToVis}}"
                                   AutomationProperties.AutomationId="LunarDateText">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="FontWeight" Value="{DynamicResource FontWeightRegular}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFirstLunarDay}" Value="True">
                                  <Setter Property="FontWeight" Value="{DynamicResource FontWeightSemiBold}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </StackPanel>

                    <!-- Events (25:170): rows gap 6, padding 4/0; time 96, dot 8, title, calendar; gap 12 -->
                    <ItemsControl Grid.Column="1" Margin="20,0,0,-6" ItemsSource="{Binding Events}" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AgendaEventItemViewModel}">
                          <!-- The time column is 96 px in Figma; it grows (same width on every row) for 12-hour times -->
                          <Grid Margin="0,0,0,6" Height="24" AutomationProperties.AutomationId="AgendaEventRow">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" MinWidth="96" SharedSizeGroup="AgendaTime" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding TimeDisplay}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="{DynamicResource FontWeightMedium}"
                                       Foreground="{DynamicResource TextSecondaryStrongBrush}"
                                       VerticalAlignment="Center" />
                            <Ellipse Grid.Column="1"
                                     Width="8" Height="8"
                                     Margin="12,0,12,0"
                                     Fill="{Binding CalendarColor, Converter={StaticResource ColorToBrush}}"
                                     VerticalAlignment="Center" />
                            <DockPanel Grid.Column="2">
                              <Path DockPanel.Dock="Left"
                                    Width="10" Height="10"
                                    Margin="0,0,4,0"
                                    Data="{DynamicResource IconSparkle10}"
                                    Fill="{DynamicResource TextPrimaryBrush}"
                                    Stretch="None"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsAi, Converter={StaticResource BoolToVis}}" />
                              <TextBlock Text="{Binding Title}"
                                         FontSize="{DynamicResource FontSizeBodyStrong}"
                                         FontWeight="{DynamicResource FontWeightMedium}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         TextTrimming="CharacterEllipsis"
                                         VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Grid.Column="3"
                                       Margin="12,0,0,0"
                                       Text="{Binding CalendarName}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
