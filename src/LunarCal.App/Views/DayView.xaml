<UserControl x:Class="LunarCal.App.Views.DayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LunarCal.App.ViewModels"
             xmlns:conv="clr-namespace:LunarCal.App.Converters"
             xmlns:bhv="clr-namespace:LunarCal.App.Behaviors"
             xmlns:loc="clr-namespace:LunarCal.App.Localization"
             xmlns:views="clr-namespace:LunarCal.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DayViewModel}"
             AutomationProperties.AutomationId="DayView">

  <!-- Figma S07 day body (25:48): day column (25:49) and the docked day detail panel (25:99, 360 px). -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:LaneMarginConverter x:Key="LaneMarginConverter" />
    <conv:LaneWidthConverter x:Key="LaneWidthConverter" />
    <conv:ColorToBrushConverter x:Key="ColorToBrush" />
  </UserControl.Resources>

  <Grid Background="{DynamicResource SurfaceBackgroundBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" DataContext="{Binding DayColumn}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Column header (25:50): padding-left 72, 12 vertical; 36 px date + two labels, gap 10 -->
      <Border Grid.Row="0"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="72,12,0,12"
              AutomationProperties.AutomationId="DayHeader">
        <StackPanel Orientation="Horizontal">
          <Border Width="36" Height="36" CornerRadius="{DynamicResource CornerRadiusFull}">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Text="{Binding SolarDayString}"
                       FontSize="{DynamicResource FontSizeAgendaDate}"
                       FontWeight="{DynamicResource FontWeightSemiBold}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding DayHeaderText}"
                       FontSize="{DynamicResource FontSizeBody}"
                       FontWeight="{DynamicResource FontWeightSemiBold}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding LunarHeaderText}"
                       Margin="0,1,0,0"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource LunarTextPrimaryBrush}"
                       Visibility="{Binding IsLunarVisible, Converter={StaticResource BoolToVis}}"
                       AutomationProperties.AutomationId="LunarDateText" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- All-day row (25:56) -->
      <Border Grid.Row="1"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1"
              AutomationProperties.AutomationId="AllDayRow">
        <Grid MinHeight="32">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{DynamicResource HourGutterGridWidth}" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0"
                     Text="{loc:Loc calendar.all_day}"
                     FontSize="{DynamicResource FontSizeMini}"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
          <Grid Grid.Column="1" Margin="4">
            <TextBlock Text="{loc:Loc day.all_day_empty}"
                       FontSize="{DynamicResource FontSizeMini}"
                       Foreground="{DynamicResource TextDisabledBrush}"
                       VerticalAlignment="Top">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding AllDayEvents.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding AllDayEvents}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:EventChipViewModel}">
                  <Border Margin="0,0,0,2"
                          Padding="{DynamicResource ThicknessPaddingEventChip}"
                          CornerRadius="{DynamicResource CornerRadiusSmall}"
                          Background="{Binding Background, Converter={StaticResource ColorToBrush}}"
                          ToolTip="{Binding Title}"
                          AutomationProperties.AutomationId="AllDayEventChip">
                    <TextBlock Text="{Binding Title}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               FontWeight="{DynamicResource FontWeightMedium}"
                               Foreground="{Binding Foreground, Converter={StaticResource ColorToBrush}}"
                               TextTrimming="CharacterEllipsis" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Grid>
      </Border>

      <!-- Time grid (25:61), opened at 07:00 -->
      <ScrollViewer Grid.Row="2"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    bhv:ScrollViewerBehavior.InitialVerticalOffset="{Binding DataContext.InitialScrollOffset, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    AutomationProperties.AutomationId="DayScrollViewer">
        <Grid Height="{DynamicResource TimeGridHeight}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{DynamicResource HourGutterGridWidth}" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <ItemsControl Grid.Column="0"
                        ItemsSource="{Binding DataContext.HourLabels, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="0,2,8,0"
                        Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Height="{DynamicResource HourRowHeight}"
                           Text="{Binding}"
                           FontSize="{DynamicResource FontSizeMini}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           TextAlignment="Right" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl Grid.Column="1"
                        ItemsSource="{Binding DataContext.HourLabels, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="0,8,0,0"
                        Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Height="{DynamicResource HourRowHeight}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
            <Canvas Margin="0,8,0,0">
              <ItemsControl ItemsSource="{Binding TimedEvents}"
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"
                            Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                  <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                    <Setter Property="Height" Value="{Binding Height}" />
                  </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:TimedEventViewModel}">
                    <!-- Event block (25:91): 8 px from the column line, 16 px before the panel; padding 6/8/0/10,
                         title 12 SemiBold, meta 11 at 80 % -->
                    <Grid Margin="0,1,0,1">
                      <Border Background="{Binding Background, Converter={StaticResource ColorToBrush}}"
                              BorderBrush="{Binding Color, Converter={StaticResource ColorToBrush}}"
                              BorderThickness="3,0,0,0"
                              CornerRadius="{DynamicResource CornerRadiusEventBlock}"
                              Padding="10,6,8,0"
                              ClipToBounds="True"
                              HorizontalAlignment="Left"
                              ToolTip="{Binding Title}"
                              AutomationProperties.AutomationId="TimedEventChip">
                        <Border.Width>
                          <MultiBinding Converter="{StaticResource LaneWidthConverter}" ConverterParameter="8,16">
                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Canvas}" />
                            <Binding Path="TotalColumns" />
                          </MultiBinding>
                        </Border.Width>
                        <Border.Margin>
                          <MultiBinding Converter="{StaticResource LaneMarginConverter}" ConverterParameter="8,16">
                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Canvas}" />
                            <Binding Path="ColumnIndex" />
                            <Binding Path="TotalColumns" />
                          </MultiBinding>
                        </Border.Margin>
                        <StackPanel>
                          <DockPanel>
                            <Path DockPanel.Dock="Left"
                                  Width="10" Height="10"
                                  Margin="0,0,4,0"
                                  Data="{DynamicResource IconSparkle10}"
                                  Fill="{Binding Foreground, Converter={StaticResource ColorToBrush}}"
                                  Stretch="None"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding IsAi, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Title}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="{DynamicResource FontWeightSemiBold}"
                                       Foreground="{Binding Foreground, Converter={StaticResource ColorToBrush}}"
                                       TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                          <TextBlock Text="{Binding DetailText}"
                                     Margin="0,2,0,0"
                                     FontSize="{DynamicResource FontSizeCaption}"
                                     Foreground="{Binding Foreground, Converter={StaticResource ColorToBrush}}"
                                     Opacity="0.8"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid Canvas.Top="{Binding NowIndicatorTop}"
                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                    Visibility="{Binding ShowNowIndicator, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="100"
                    AutomationProperties.AutomationId="NowIndicator">
                <Rectangle Height="2" Margin="0,-1,0,0" VerticalAlignment="Top" Fill="{DynamicResource NowLineBrush}" />
                <Ellipse Width="10" Height="10"
                         Margin="-6,-5,0,0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Fill="{DynamicResource NowLineBrush}" />
              </Grid>
            </Canvas>
          </Border>
        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- Day detail panel (S09 component, docked) -->
    <views:DayDetailPanel Grid.Column="1" DataContext="{Binding DetailPanel}" />
  </Grid>
</UserControl>
