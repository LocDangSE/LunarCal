<UserControl x:Class="LunarCal.App.Views.DayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LunarCal.App.ViewModels"
             xmlns:conv="clr-namespace:LunarCal.App.Converters"
             xmlns:loc="clr-namespace:LunarCal.App.Localization"
             xmlns:views="clr-namespace:LunarCal.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DayViewModel}"
             AutomationProperties.AutomationId="DayView">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:LaneMarginConverter x:Key="LaneMarginConverter" />
    <conv:LaneWidthConverter x:Key="LaneWidthConverter" />
  </UserControl.Resources>

  <Grid Background="{DynamicResource WindowBackgroundBrush}">
    <Grid.ColumnDefinitions>
      <!-- Main single day calendar grid area -->
      <ColumnDefinition Width="*" />
      <!-- Right-side Day Detail Panel Container (Figma S07 & S09, 360 px) -->
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- MAIN DAY GRID AREA -->
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <!-- Row 0: Column Header (Thứ + Ngày dương + Ngày âm) -->
        <RowDefinition Height="Auto" />
        <!-- Row 1: All-day events row -->
        <RowDefinition Height="Auto" />
        <!-- Row 2: Scrollable 24-hour timed grid -->
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- ROW 0: HEADER (Single day header) -->
      <Border Grid.Row="0"
              Background="{DynamicResource SurfaceBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1"
              DataContext="{Binding DayColumn}"
              AutomationProperties.AutomationId="DayHeaderBar">
        <Grid>
          <Grid.ColumnDefinitions>
            <!-- Left hour column placeholder (56 px) -->
            <ColumnDefinition Width="56" />
            <!-- Day header column -->
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="1"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1,0,0,0"
                  Padding="16,8"
                  HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <!-- Solar Day Circle if today -->
              <Border CornerRadius="{DynamicResource CornerRadiusDayNumber}"
                      Width="28" Height="28"
                      Margin="0,0,8,0">
                <Border.Style>
                  <Style TargetType="Border">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsToday}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TodayHighlightBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding SolarDayString}"
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="{DynamicResource FontWeightBold}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Border>

              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding DayOfWeekName}"
                           FontSize="{DynamicResource FontSizeSubtitle}"
                           FontWeight="{DynamicResource FontWeightSemiBold}"
                           Foreground="{DynamicResource TextPrimaryBrush}" />

                <!-- Lunar Date (FR-UI-1, FR-UI-2, FR-LUNAR-6) -->
                <TextBlock Text="{Binding LunarLabelText}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           FontWeight="{DynamicResource FontWeightMedium}"
                           Foreground="{DynamicResource LunarTextPrimaryBrush}"
                           Margin="0,2,0,0"
                           AutomationProperties.AutomationId="LunarDateText">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding LunarDayText}" Value="">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLunarVisible}" Value="False">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- ROW 1: ALL-DAY ROW (FR-UI-1) -->
      <Border Grid.Row="1"
              Background="{DynamicResource SurfaceBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1"
              MinHeight="28"
              DataContext="{Binding DayColumn}"
              AutomationProperties.AutomationId="AllDayRow">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0"
                     Text="{loc:Loc calendar.all_day}"
                     FontSize="{DynamicResource FontSizeMini}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center" />

          <Border Grid.Column="1"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1,0,0,0"
                  Padding="4">
            <ItemsControl ItemsSource="{Binding AllDayEvents}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource AccentSubtleBrush}"
                          BorderBrush="{DynamicResource AccentPrimaryBrush}"
                          BorderThickness="1"
                          CornerRadius="{DynamicResource CornerRadiusSmall}"
                          Padding="{DynamicResource ThicknessPaddingEventChip}"
                          Margin="0,1"
                          ToolTip="{Binding Title}"
                          AutomationProperties.AutomationId="AllDayEventChip">
                    <TextBlock Text="{Binding Title}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               FontWeight="{DynamicResource FontWeightMedium}"
                               Foreground="{DynamicResource AccentTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </Grid>
      </Border>

      <!-- ROW 2: SCROLLABLE 24-HOUR TIMED GRID -->
      <ScrollViewer Grid.Row="2"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    AutomationProperties.AutomationId="DayScrollViewer">
        <Grid Height="1152">
          <Grid.ColumnDefinitions>
            <!-- Left hour label column (56 px) -->
            <ColumnDefinition Width="56" />
            <!-- Main day column -->
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Hour labels (00:00 .. 23:00) -->
          <ItemsControl Grid.Column="0" ItemsSource="{Binding HourLabels}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="24" Columns="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Height="{DynamicResource HourRowHeight}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,1"
                        Background="{DynamicResource SurfaceBackgroundBrush}">
                  <TextBlock Text="{Binding}"
                             FontSize="{DynamicResource FontSizeMini}"
                             Foreground="{DynamicResource TextTertiaryBrush}"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,-7,6,0" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Day Column Timed Area -->
          <Grid Grid.Column="1">
            <!-- Background Hour Horizontal Grid Lines (24 rows) -->
            <ItemsControl ItemsSource="{Binding HourLabels}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="24" Columns="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Height="{DynamicResource HourRowHeight}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="0,0,0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Timed events and now indicator inside DayColumn -->
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    DataContext="{Binding DayColumn}">
              <Canvas Height="1152" ClipToBounds="True">
                <!-- Timed Events on Canvas -->
                <ItemsControl ItemsSource="{Binding TimedEvents}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                      <Setter Property="Canvas.Top" Value="{Binding Top}" />
                      <Setter Property="Height" Value="{Binding Height}" />
                      <Setter Property="Panel.ZIndex" Value="10" />
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TimedEventViewModel}">
                      <Border Background="{DynamicResource AccentSubtleBrush}"
                              BorderBrush="{DynamicResource AccentPrimaryBrush}"
                              BorderThickness="2,0,0,0"
                              CornerRadius="{DynamicResource CornerRadiusSmall}"
                              Padding="6,4"
                              ToolTip="{Binding Title}"
                              Height="{Binding Height}"
                              AutomationProperties.AutomationId="TimedEventChip">
                        <Border.Width>
                          <MultiBinding Converter="{StaticResource LaneWidthConverter}">
                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Canvas}" />
                            <Binding Path="TotalColumns" />
                          </MultiBinding>
                        </Border.Width>
                        <Border.Margin>
                          <MultiBinding Converter="{StaticResource LaneMarginConverter}">
                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Canvas}" />
                            <Binding Path="ColumnIndex" />
                            <Binding Path="TotalColumns" />
                          </MultiBinding>
                        </Border.Margin>
                        <Grid>
                          <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       FontWeight="{DynamicResource FontWeightSemiBold}"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding TimeRangeText}"
                                       FontSize="{DynamicResource FontSizeMini}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Now Indicator Line (S07, NowLineBrush) -->
                <Grid Canvas.Top="{Binding NowIndicatorTop}"
                      Visibility="{Binding ShowNowIndicator, Converter={StaticResource BoolToVis}}"
                      Panel.ZIndex="100"
                      AutomationProperties.AutomationId="NowIndicator">
                  <Ellipse Width="8" Height="8"
                           Fill="{DynamicResource NowLineBrush}"
                           Margin="-4,-4,0,0"
                           HorizontalAlignment="Left" />
                  <Line X1="0" Y1="0"
                        X2="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                        Y2="0"
                        Stroke="{DynamicResource NowLineBrush}"
                        StrokeThickness="2" />
                </Grid>
              </Canvas>
            </Border>
          </Grid>
        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- RIGHT-SIDE DETAIL PANEL (Figma S07 & S09, Width 360 px) -->
    <Border Grid.Column="1"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1,0,0,0">
      <views:DayDetailPanel DataContext="{Binding DetailPanel}" />
    </Border>
  </Grid>
</UserControl>
