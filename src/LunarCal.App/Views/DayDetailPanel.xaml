<UserControl x:Class="LunarCal.App.Views.DayDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LunarCal.App.ViewModels"
             xmlns:conv="clr-namespace:LunarCal.App.Converters"
             xmlns:loc="clr-namespace:LunarCal.App.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DayDetailViewModel}"
             Width="{DynamicResource DayDetailPanelWidth}"
             AutomationProperties.AutomationId="DayDetailPanel">

  <!-- Figma S09 "Day detail panel" component (25:2): 360 px, white, left border, padding 20, gap 20.
       With the lunar calendar off (FR-LUNAR-6) the lunar block and the can chi table are hidden. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:ColorToBrushConverter x:Key="ColorToBrush" />

    <!-- Row of the can chi / tiết khí table (25:17): padding 10/14, label 12 Regular, value 13 SemiBold -->
    <Style x:Key="TableLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="TableValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBodyStrong}" />
      <Setter Property="FontWeight" Value="{DynamicResource FontWeightSemiBold}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="TableRow" TargetType="Border">
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- Buttons (25:44, 25:46): radius 8, padding 9/14, 13 SemiBold -->
    <Style x:Key="PanelButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource CornerRadiusMedium}"
                    Padding="{DynamicResource ThicknessPaddingButton}">
              <ContentPresenter HorizontalAlignment="Center"
                                TextElement.FontSize="{DynamicResource FontSizeBodyStrong}"
                                TextElement.FontWeight="{DynamicResource FontWeightSemiBold}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Opacity" Value="0.9" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border Background="{DynamicResource SurfaceBackgroundBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1,0,0,0">
    <DockPanel Margin="20" LastChildFill="True">

      <!-- Header (25:3): weekday 12 Medium, date 18 Bold, close button 32 px -->
      <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding WeekdayName}"
                     FontSize="{DynamicResource FontSizeBody}"
                     FontWeight="{DynamicResource FontWeightMedium}"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="{Binding SolarDateShort}"
                     Margin="0,2,0,0"
                     FontSize="{DynamicResource FontSizePanelTitle}"
                     FontWeight="{DynamicResource FontWeightBold}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="1"
                Command="{Binding CloseCommand}"
                Cursor="Hand"
                VerticalAlignment="Top"
                ToolTip="{loc:Loc Key=day_detail.close}"
                AutomationProperties.Name="{loc:Loc Key=day_detail.close}"
                AutomationProperties.AutomationId="BtnCloseDayDetail">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Grid Width="32" Height="32">
                <Border x:Name="border"
                        Background="{DynamicResource SurfaceBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadiusMedium}" />
                <Path Width="32" Height="32"
                      Data="{DynamicResource IconClose32}"
                      Stroke="{DynamicResource TextSecondaryBrush}"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stretch="None" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </Grid>

      <!-- Actions (25:43), docked at the bottom, gap 8 -->
      <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
        <Button Content="{loc:Loc Key=day_detail.add_event}"
                Command="{Binding AddEventCommand}"
                Style="{StaticResource PanelButton}"
                Background="{DynamicResource AccentPrimaryBrush}"
                BorderThickness="0"
                Foreground="{DynamicResource OnAccentBrush}"
                AutomationProperties.AutomationId="BtnAddEvent" />
        <Button Content="{loc:Loc Key=day_detail.add_lunar_rule}"
                Command="{Binding AddLunarRuleCommand}"
                Style="{StaticResource PanelButton}"
                Margin="0,8,0,0"
                Visibility="{Binding IsLunarVisible, Converter={StaticResource BoolToVis}}"
                AutomationProperties.AutomationId="BtnAddLunarRule" />
      </StackPanel>

      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <!-- Lunar block (25:10): #FFF4E5, radius 12, padding 14/16, gap 14 -->
          <Border Background="{DynamicResource LunarSubtleBrush}"
                  CornerRadius="{DynamicResource CornerRadiusLarge}"
                  Padding="16,14"
                  Margin="0,0,0,20"
                  Visibility="{Binding HasLunarDate, Converter={StaticResource BoolToVis}}"
                  AutomationProperties.AutomationId="LunarDetailBlock">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding LunarDayNumberText}"
                         FontSize="{DynamicResource FontSizeLunarBlock}"
                         FontWeight="{DynamicResource FontWeightBold}"
                         Foreground="{DynamicResource LunarTextPrimaryBrush}"
                         VerticalAlignment="Center"
                         AutomationProperties.AutomationId="LunarDayNumber" />
              <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc Key=lunar.label}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           FontWeight="{DynamicResource FontWeightSemiBold}"
                           Foreground="{DynamicResource LunarTextPrimaryBrush}" />
                <TextBlock Text="{Binding LunarFullText}"
                           Margin="0,2,0,0"
                           FontSize="{DynamicResource FontSizeBodyStrong}"
                           FontWeight="{DynamicResource FontWeightMedium}"
                           Foreground="{DynamicResource LunarStrongBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding LunarMonthInfoText}"
                           Margin="0,2,0,0"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource LunarTextPrimaryBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Can chi & tiết khí table (25:16): white, border, radius 12 -->
          <Border BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource CornerRadiusLarge}"
                  Margin="0,0,0,20"
                  Visibility="{Binding HasLunarDate, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <Border Style="{StaticResource TableRow}">
                <DockPanel>
                  <TextBlock Text="{loc:Loc Key=day_detail.can_chi_day}" Style="{StaticResource TableLabel}" DockPanel.Dock="Left" />
                  <TextBlock Text="{Binding DayCanChiText}" Style="{StaticResource TableValue}"
                             AutomationProperties.AutomationId="DayCanChiText" />
                </DockPanel>
              </Border>
              <Border Style="{StaticResource TableRow}">
                <DockPanel>
                  <TextBlock Text="{loc:Loc Key=day_detail.can_chi_month}" Style="{StaticResource TableLabel}" DockPanel.Dock="Left" />
                  <TextBlock Text="{Binding MonthCanChiText}" Style="{StaticResource TableValue}"
                             AutomationProperties.AutomationId="MonthCanChiText" />
                </DockPanel>
              </Border>
              <Border Style="{StaticResource TableRow}">
                <DockPanel>
                  <TextBlock Text="{loc:Loc Key=day_detail.can_chi_year}" Style="{StaticResource TableLabel}" DockPanel.Dock="Left" />
                  <TextBlock Text="{Binding YearCanChiText}" Style="{StaticResource TableValue}"
                             AutomationProperties.AutomationId="YearCanChiText" />
                </DockPanel>
              </Border>
              <Border Style="{StaticResource TableRow}" BorderThickness="0">
                <DockPanel>
                  <TextBlock Text="{loc:Loc Key=day_detail.solar_term}" Style="{StaticResource TableLabel}" DockPanel.Dock="Left" />
                  <TextBlock Text="{Binding SolarTermRowText}" Style="{StaticResource TableValue}"
                             AutomationProperties.AutomationId="SolarTermText" />
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Events (25:29): header 11 SemiBold tertiary, items gap 8 -->
          <TextBlock Text="{Binding EventsHeaderText}"
                     FontSize="{DynamicResource FontSizeCaption}"
                     FontWeight="{DynamicResource FontWeightSemiBold}"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     Margin="0,0,0,8" />

          <TextBlock Text="{loc:Loc Key=day_detail.no_events}"
                     FontSize="{DynamicResource FontSizeBody}"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     AutomationProperties.AutomationId="DayEventsEmptyState">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasEvents}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <ItemsControl ItemsSource="{Binding Events}" Focusable="False" AutomationProperties.AutomationId="DayEventsList">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:AgendaEventItemViewModel}">
                <!-- Event item (25:32): #F9FAFB, radius 10, padding 10/12, 3×34 stripe, gap 10 -->
                <Border Background="{DynamicResource SurfaceMutedBrush}"
                        CornerRadius="{DynamicResource CornerRadiusListItem}"
                        Padding="12,10"
                        Margin="0,0,0,8">
                  <DockPanel>
                    <Border DockPanel.Dock="Left"
                            Width="3" Height="34"
                            Margin="0,0,10,0"
                            CornerRadius="{DynamicResource CornerRadiusStripe}"
                            Background="{Binding CalendarColor, Converter={StaticResource ColorToBrush}}"
                            VerticalAlignment="Top" />
                    <StackPanel>
                      <TextBlock Text="{Binding Title}"
                                 FontSize="{DynamicResource FontSizeBodyStrong}"
                                 FontWeight="{DynamicResource FontWeightSemiBold}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding MetaText}"
                                 Margin="0,2,0,0"
                                 FontSize="{DynamicResource FontSizeCaption}"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
