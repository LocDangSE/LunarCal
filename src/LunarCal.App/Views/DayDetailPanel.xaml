<UserControl x:Class="LunarCal.App.Views.DayDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LunarCal.App.ViewModels"
             xmlns:conv="clr-namespace:LunarCal.App.Converters"
             xmlns:loc="clr-namespace:LunarCal.App.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DayDetailViewModel}"
             Width="{DynamicResource DayDetailPanelWidth}"
             Background="{DynamicResource SurfaceBackgroundBrush}"
             AutomationProperties.AutomationId="DayDetailPanel">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:ColorToBrushConverter x:Key="ColorToBrush" />
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <!-- Row 0: Top Header with Solar Date Title & Close Button -->
      <RowDefinition Height="Auto" />
      <!-- Row 1: Scrollable Body (Lunar Block + Events) -->
      <RowDefinition Height="*" />
      <!-- Row 2: Bottom Action Buttons -->
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ROW 0: HEADER -->
    <Border Grid.Row="0"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="{loc:Loc day_detail.title}"
                     FontSize="{DynamicResource FontSizeCaption}"
                     FontWeight="{DynamicResource FontWeightMedium}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Margin="0,0,0,2" />
          <TextBlock Text="{Binding SolarDateTitle}"
                     FontSize="{DynamicResource FontSizeSubtitle}"
                     FontWeight="{DynamicResource FontWeightBold}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Close Button (if applicable) -->
        <Button Grid.Column="1"
                Command="{Binding CloseCommand}"
                Width="28" Height="28"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="BtnCloseDayDetail">
          <TextBlock Text="✕"
                     FontSize="14"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Button>
      </Grid>
    </Border>

    <!-- ROW 1: SCROLLABLE CONTENT BODY -->
    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="20,16">
      <StackPanel>

        <!-- LUNAR DETAILS CARD (Figma S09, FR-UI-3, FR-I18N-5, FR-LUNAR-8) -->
        <Border Margin="0,0,0,20"
                CornerRadius="{DynamicResource CornerRadiusLarge}"
                AutomationProperties.AutomationId="LunarDetailBlock">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource LunarSubtleBrush}" />
              <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="Padding" Value="16" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsLunarVisible}" Value="False">
                  <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>

          <Grid>
            <!-- When Lunar is Enabled -->
            <StackPanel Visibility="{Binding IsLunarVisible, Converter={StaticResource BoolToVis}}">
              <!-- Top Row: Big Lunar Day + Month & Year -->
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Big Lunar Day Number -->
                <TextBlock Grid.Column="0"
                           Text="{Binding LunarDayNumberText}"
                           FontSize="40"
                           FontWeight="{DynamicResource FontWeightBold}"
                           Foreground="{DynamicResource LunarStrongBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0"
                           AutomationProperties.AutomationId="LunarDayNumber" />

                <!-- Lunar Month & Year info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding LunarMonthText}"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontWeight="{DynamicResource FontWeightBold}"
                               Foreground="{DynamicResource LunarTextPrimaryBrush}" />
                    <!-- Leap Badge if applicable -->
                    <Border Background="{DynamicResource LunarStrongBrush}"
                            CornerRadius="{DynamicResource CornerRadiusSmall}"
                            Padding="6,2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsLeapMonth, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="{loc:Loc lunar.leap}"
                                 FontSize="{DynamicResource FontSizeMini}"
                                 FontWeight="{DynamicResource FontWeightBold}"
                                 Foreground="{DynamicResource OnAccentBrush}" />
                    </Border>
                  </StackPanel>

                  <TextBlock Text="{Binding YearCanChiText}"
                             FontSize="{DynamicResource FontSizeBody}"
                             FontWeight="{DynamicResource FontWeightMedium}"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Margin="0,2,0,0"
                             AutomationProperties.AutomationId="YearCanChiText" />
                </StackPanel>
              </Grid>

              <!-- Subtle Divider -->
              <Border Height="1"
                      Background="{DynamicResource BorderBrush}"
                      Margin="0,0,0,12" />

              <!-- Can Chi Matrix (Day / Month / Year) -->
              <Grid Margin="0,0,0,12">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Row 0: Can Chi Ngày -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{loc:Loc day_detail.can_chi_day}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,6" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding DayCanChiText}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           FontWeight="{DynamicResource FontWeightSemiBold}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6"
                           AutomationProperties.AutomationId="DayCanChiText" />

                <!-- Row 1: Can Chi Tháng -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{loc:Loc day_detail.can_chi_month}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,6" />
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding MonthCanChiText}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           FontWeight="{DynamicResource FontWeightSemiBold}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6"
                           AutomationProperties.AutomationId="MonthCanChiText" />

                <!-- Row 2: Can Chi Năm -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="{loc:Loc day_detail.can_chi_year}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding YearCanChiText}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           FontWeight="{DynamicResource FontWeightSemiBold}"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
              </Grid>

              <!-- Solar Term (Tiết khí) Row -->
              <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource CornerRadiusMedium}"
                      Padding="10,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc day_detail.solar_term}"
                               FontSize="{DynamicResource FontSizeMini}"
                               FontWeight="{DynamicResource FontWeightMedium}"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Text="{Binding SolarTermText}"
                               FontSize="{DynamicResource FontSizeBodyStrong}"
                               FontWeight="{DynamicResource FontWeightSemiBold}"
                               Foreground="{DynamicResource LunarTextPrimaryBrush}"
                               Margin="0,2,0,0"
                               AutomationProperties.AutomationId="SolarTermText" />
                  </StackPanel>

                  <!-- Term Starts Today badge or Term degrees -->
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AccentSubtleBrush}"
                            CornerRadius="{DynamicResource CornerRadiusSmall}"
                            Padding="6,2"
                            Margin="0,0,6,0"
                            Visibility="{Binding IsSolarTermStartDay, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="{loc:Loc day_detail.solar_term_start}"
                                 FontSize="{DynamicResource FontSizeMini}"
                                 FontWeight="{DynamicResource FontWeightSemiBold}"
                                 Foreground="{DynamicResource AccentTextBrush}" />
                    </Border>

                    <TextBlock Text="{Binding SolarTermDegreesText}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               FontWeight="{DynamicResource FontWeightMedium}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>

            <!-- When Lunar is Disabled (FR-LUNAR-6) -->
            <StackPanel Visibility="{Binding IsLunarVisible, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLunarVisible}" Value="False">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="🌙"
                         FontSize="20"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,6" />
              <TextBlock Text="{loc:Loc day_detail.lunar_disabled}"
                         FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         HorizontalAlignment="Center"
                         TextAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- EVENTS IN DAY SECTION (FR-UI-3) -->
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0"
                     Text="{loc:Loc day_detail.events_title}"
                     FontSize="{DynamicResource FontSizeSubtitle}"
                     FontWeight="{DynamicResource FontWeightBold}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     VerticalAlignment="Center" />

          <!-- Event Count Badge -->
          <Border Grid.Column="1"
                  Background="{DynamicResource ControlTrackBrush}"
                  CornerRadius="{DynamicResource CornerRadiusFull}"
                  Padding="8,2"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding Events.Count}"
                       FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="{DynamicResource FontWeightSemiBold}"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </Border>
        </Grid>

        <!-- Empty State Message when no events -->
        <Border Padding="16,24"
                Background="{DynamicResource SurfaceMutedBrush}"
                CornerRadius="{DynamicResource CornerRadiusMedium}"
                Margin="0,0,0,12"
                AutomationProperties.AutomationId="DayEventsEmptyState">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasEvents}" Value="False">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="📅"
                       FontSize="24"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8" />
            <TextBlock Text="{loc:Loc day_detail.no_events}"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- Event List -->
        <ItemsControl ItemsSource="{Binding Events}"
                      AutomationProperties.AutomationId="DayEventsList">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:AgendaEventItemViewModel}">
              <Border Background="{DynamicResource SurfaceElevatedBackgroundBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource CornerRadiusMedium}"
                      Padding="12,10"
                      Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <!-- Left Color Stripe -->
                    <ColumnDefinition Width="4" />
                    <!-- Details (Time, Title, Location) -->
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- Calendar Color Stripe -->
                  <Border Grid.Column="0"
                          Background="{Binding CalendarColor, Converter={StaticResource ColorToBrush}}"
                          CornerRadius="2"
                          Margin="0,0,10,0" />

                  <StackPanel Grid.Column="1">
                    <!-- Top line: Time & Calendar Name Badge -->
                    <Grid Margin="0,0,0,2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0"
                                 Text="{Binding TimeDisplay}"
                                 FontSize="{DynamicResource FontSizeCaption}"
                                 FontWeight="{DynamicResource FontWeightSemiBold}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding CalendarName}"
                                 FontSize="{DynamicResource FontSizeMini}"
                                 Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Grid>

                    <!-- Title -->
                    <TextBlock Text="{Binding Title}"
                               FontSize="{DynamicResource FontSizeBodyStrong}"
                               FontWeight="{DynamicResource FontWeightSemiBold}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Location -->
                    <TextBlock Text="{Binding Location, StringFormat='📍 {0}'}"
                               FontSize="{DynamicResource FontSizeMini}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,2,0,0"
                               Visibility="{Binding HasLocation, Converter={StaticResource BoolToVis}}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>

    <!-- ROW 2: BOTTOM ACTION BUTTONS (Figma S09) -->
    <Border Grid.Row="2"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,14"
            Background="{DynamicResource SurfaceBackgroundBrush}">
      <StackPanel Orientation="Vertical">
        <!-- Add Event Button -->
        <Button Command="{Binding AddEventCommand}"
                Background="{DynamicResource AccentPrimaryBrush}"
                Foreground="{DynamicResource OnAccentBrush}"
                FontWeight="{DynamicResource FontWeightSemiBold}"
                FontSize="{DynamicResource FontSizeBody}"
                Padding="0,8"
                BorderThickness="0"
                Cursor="Hand"
                Margin="0,0,0,8"
                AutomationProperties.AutomationId="BtnAddEvent">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}"
                      CornerRadius="{DynamicResource CornerRadiusMedium}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Button.Template>
          <TextBlock Text="{loc:Loc day_detail.add_event}" />
        </Button>

        <!-- Add Lunar Rule Button -->
        <Button Command="{Binding AddLunarRuleCommand}"
                Background="{DynamicResource SurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Foreground="{DynamicResource TextPrimaryBrush}"
                FontWeight="{DynamicResource FontWeightMedium}"
                FontSize="{DynamicResource FontSizeCaption}"
                Padding="0,6"
                Cursor="Hand"
                AutomationProperties.AutomationId="BtnAddLunarRule">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{DynamicResource CornerRadiusMedium}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Button.Template>
          <TextBlock Text="{loc:Loc day_detail.add_lunar_rule}" />
        </Button>
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
