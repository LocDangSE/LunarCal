<Window x:Class="LunarCal.App.Views.AiConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chat="clr-namespace:LunarCal.Core.Chat;assembly=LunarCal.Core"
        xmlns:loc="clr-namespace:LunarCal.App.Localization"
        Title="{loc:Loc ai_confirm.title}"
        Width="{DynamicResource AiConfirmDialogWidth}"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource FontFamilyBase}"
        AutomationProperties.AutomationId="AiConfirmDialog">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>

  <!-- Figma 02 · AI xác nhận yêu cầu (2:2; dialog 2:494, scrim 2:493) -->
  <Border Margin="24"
          Background="{DynamicResource SurfaceBackgroundBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="{DynamicResource CornerRadiusDialog}"
          Effect="{DynamicResource ShadowDialog}">
    <StackPanel>
      <!-- Header: Status Badge, Title, Subtitle, Close Button -->
      <Grid Margin="24,20,24,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <Border HorizontalAlignment="Left" Padding="10,4"
                  Background="{DynamicResource WarningSubtleBrush}"
                  BorderBrush="{DynamicResource WarningBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource CornerRadiusPill}">
            <TextBlock Text="{loc:Loc ai_confirm.status_pending}"
                       FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="{DynamicResource FontWeightSemiBold}"
                       Foreground="{DynamicResource WarningTextBrush}"
                       AutomationProperties.AutomationId="AiConfirmStatusBadge" />
          </Border>

          <TextBlock Text="{loc:Loc ai_confirm.title}"
                     Margin="0,8,0,0"
                     FontSize="{DynamicResource FontSizeDialogTitle}"
                     FontWeight="{DynamicResource FontWeightBold}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     AutomationProperties.AutomationId="AiConfirmTitle" />

          <TextBlock Text="{loc:Loc ai_confirm.subtitle}"
                     Margin="0,4,0,0"
                     FontSize="{DynamicResource FontSizeBody}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap"
                     AutomationProperties.AutomationId="AiConfirmSubtitle" />
        </StackPanel>

        <!-- Close button ✕ -->
        <Button Grid.Column="1"
                VerticalAlignment="Top"
                Width="32" Height="32"
                Style="{StaticResource GhostButtonStyle}"
                Padding="0"
                Command="{Binding CancelCommand}"
                AutomationProperties.AutomationId="BtnAiConfirmClose"
                AutomationProperties.Name="{loc:Loc common.close}">
          <Path Data="{DynamicResource IconClose32}"
                Width="12" Height="12"
                Stretch="Uniform"
                Fill="{DynamicResource TextSecondaryBrush}" />
        </Button>
      </Grid>

      <!-- Scrollable content area -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520" Focusable="False">
        <StackPanel Margin="24,0,24,16">

          <!-- 1. BẠN ĐÃ NHẬP (User input block) -->
          <TextBlock Text="{loc:Loc ai_confirm.section_user_input}"
                     FontSize="{DynamicResource FontSizeCaption}"
                     FontWeight="{DynamicResource FontWeightSemiBold}"
                     Foreground="{DynamicResource TextTertiaryBrush}" />

          <Border Margin="0,6,0,0" Padding="14,12"
                  Background="{DynamicResource SurfaceMutedBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource CornerRadiusMedium}">
            <StackPanel>
              <TextBlock Text="{Binding OriginalText}"
                         FontSize="{DynamicResource FontSizeBodyStrong}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         TextWrapping="Wrap"
                         AutomationProperties.AutomationId="AiConfirmOriginalText" />

              <DockPanel Margin="0,8,0,0" LastChildFill="False">
                <Border DockPanel.Dock="Left" Padding="8,2"
                        Background="{DynamicResource AiSubtleBrush}"
                        CornerRadius="{DynamicResource CornerRadiusPill}">
                  <TextBlock Text="{Binding InputLangDisplay}"
                             FontSize="{DynamicResource FontSizeCaption}"
                             FontWeight="{DynamicResource FontWeightMedium}"
                             Foreground="{DynamicResource AiTextBrush}" />
                </Border>

                <TextBlock DockPanel.Dock="Left" Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding TypedAtDisplay, StringFormat='{}Lúc {0}'}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Text="{loc:Loc ai_confirm.time_anchor_hint}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
              </DockPanel>
            </StackPanel>
          </Border>

          <!-- 2. KẾT QUẢ PHÂN TÍCH (Analysis Breakdown) -->
          <TextBlock Text="{loc:Loc ai_confirm.section_analysis}"
                     Margin="0,16,0,0"
                     FontSize="{DynamicResource FontSizeCaption}"
                     FontWeight="{DynamicResource FontWeightSemiBold}"
                     Foreground="{DynamicResource TextTertiaryBrush}" />

          <Border Margin="0,6,0,0" Padding="14,12"
                  Background="{DynamicResource SurfaceBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource CornerRadiusMedium}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!-- Row 0: Hành động -->
              <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4"
                         Text="{loc:Loc ai_confirm.label_action}"
                         FontSize="{DynamicResource FontSizeBody}"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <Border Grid.Row="0" Grid.Column="1" Margin="0,4"
                      HorizontalAlignment="Left" Padding="8,3"
                      Background="{DynamicResource AccentSubtleBrush}"
                      CornerRadius="{DynamicResource CornerRadiusSmall}">
                <TextBlock Text="{Binding ActionName}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           FontWeight="{DynamicResource FontWeightSemiBold}"
                           Foreground="{DynamicResource AccentTextBrush}"
                           AutomationProperties.AutomationId="AiConfirmActionName" />
              </Border>

              <!-- Row 1: Tiêu đề -->
              <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6"
                         Text="{loc:Loc ai_confirm.label_title}"
                         FontSize="{DynamicResource FontSizeBody}"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6"
                         Text="{Binding EventTitle}"
                         FontSize="{DynamicResource FontSizeBodyStrong}"
                         FontWeight="{DynamicResource FontWeightSemiBold}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         TextWrapping="Wrap"
                         AutomationProperties.AutomationId="AiConfirmEventTitle" />

              <!-- Row 2: Ngày -->
              <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4"
                         Text="{loc:Loc ai_confirm.label_date}"
                         FontSize="{DynamicResource FontSizeBody}"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,4" Orientation="Horizontal">
                <TextBlock Text="{Binding EventDateDisplay}"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeBodyStrong}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           AutomationProperties.AutomationId="AiConfirmEventDate" />
                <Border Margin="10,0,0,0" Padding="8,2"
                        Background="{DynamicResource LunarSubtleBrush}"
                        CornerRadius="{DynamicResource CornerRadiusSmall}"
                        Visibility="{Binding IsLunarVisible, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="{Binding EventLunarDateDisplay}"
                             FontSize="{DynamicResource FontSizeCaption}"
                             FontWeight="{DynamicResource FontWeightMedium}"
                             Foreground="{DynamicResource LunarTextBrush}"
                             AutomationProperties.AutomationId="AiConfirmLunarDate" />
                </Border>
              </StackPanel>

              <!-- Row 3: Giờ -->
              <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4"
                         Text="{loc:Loc ai_confirm.label_time}"
                         FontSize="{DynamicResource FontSizeBody}"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4"
                         Text="{Binding EventTimeDisplay}"
                         FontSize="{DynamicResource FontSizeBodyStrong}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         AutomationProperties.AutomationId="AiConfirmEventTime" />

              <!-- Row 4: Lặp lại -->
              <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,4"
                         Text="{loc:Loc ai_confirm.label_recurrence}"
                         FontSize="{DynamicResource FontSizeBody}"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4"
                         Text="{Binding RecurrenceDisplay}"
                         FontSize="{DynamicResource FontSizeBody}"
                         Foreground="{DynamicResource TextBodyBrush}"
                         AutomationProperties.AutomationId="AiConfirmRecurrence" />

              <!-- Row 5: Nhắc trước -->
              <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,4"
                         Text="{loc:Loc ai_confirm.label_reminder}"
                         FontSize="{DynamicResource FontSizeBody}"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,4"
                         Text="{Binding RemindersDisplay}"
                         FontSize="{DynamicResource FontSizeBody}"
                         Foreground="{DynamicResource TextBodyBrush}"
                         AutomationProperties.AutomationId="AiConfirmReminders" />

              <!-- Row 6: Lịch đích -->
              <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,4"
                         Text="{loc:Loc ai_confirm.label_calendar}"
                         FontSize="{DynamicResource FontSizeBody}"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,4" Orientation="Horizontal">
                <Border Width="10" Height="10" VerticalAlignment="Center"
                        CornerRadius="{DynamicResource CornerRadiusFull}"
                        Background="{DynamicResource AccentPrimaryBrush}" />
                <TextBlock Text="{Binding TargetCalendarName}" Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeBodyStrong}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           AutomationProperties.AutomationId="AiConfirmCalendar" />
              </StackPanel>

              <!-- Row 7: Độ tin cậy (FR-CONFIRM-4) -->
              <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,8,0,4"
                         Text="{loc:Loc ai_confirm.label_confidence}"
                         FontSize="{DynamicResource FontSizeBody}"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,8,0,4">
                <TextBlock Text="{Binding ConfidenceDisplay}"
                           FontSize="{DynamicResource FontSizeBodyStrong}"
                           FontWeight="{DynamicResource FontWeightSemiBold}"
                           AutomationProperties.AutomationId="AiConfirmConfidence">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static chat:AiConfidenceLevel.Medium}">
                          <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static chat:AiConfidenceLevel.Low}">
                          <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>

                <!-- Confidence bar -->
                <ProgressBar Margin="0,4,0,0" Height="6" Value="{Binding ConfidenceScore}" Maximum="100"
                             Background="{DynamicResource ControlTrackBrush}"
                             BorderThickness="0"
                             AutomationProperties.AutomationId="AiConfirmConfidenceBar">
                  <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static chat:AiConfidenceLevel.Medium}">
                          <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ConfidenceLevel}" Value="{x:Static chat:AiConfidenceLevel.Low}">
                          <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ProgressBar.Style>
                </ProgressBar>
              </StackPanel>
            </Grid>
          </Border>

          <!-- 3. KIỂM TRA NGHIỆP VỤ (FR-CONFIRM-5) -->
          <TextBlock Text="{loc:Loc ai_confirm.section_validation}"
                     Margin="0,16,0,0"
                     FontSize="{DynamicResource FontSizeCaption}"
                     FontWeight="{DynamicResource FontWeightSemiBold}"
                     Foreground="{DynamicResource TextTertiaryBrush}" />

          <Border Margin="0,6,0,0" Padding="14,10"
                  CornerRadius="{DynamicResource CornerRadiusMedium}"
                  AutomationProperties.AutomationId="AiConfirmValidationBox">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ValidationSeverity}" Value="{x:Static chat:AiBusinessValidationSeverity.Warning}">
                    <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ValidationSeverity}" Value="{x:Static chat:AiBusinessValidationSeverity.Error}">
                    <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>

            <TextBlock Text="{Binding ValidationSummary}"
                       FontSize="{DynamicResource FontSizeBody}"
                       FontWeight="{DynamicResource FontWeightMedium}"
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="AiConfirmValidationMessage">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ValidationSeverity}" Value="{x:Static chat:AiBusinessValidationSeverity.Warning}">
                      <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ValidationSeverity}" Value="{x:Static chat:AiBusinessValidationSeverity.Error}">
                      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>

          <!-- 4. GHI CHÚ QUYỀN RIÊNG TƯ (FR-CONFIRM-6, chuỗi spec §4.11) -->
          <TextBlock Text="{Binding PrivacyNotice}"
                     Margin="0,12,0,0"
                     FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     TextWrapping="Wrap"
                     AutomationProperties.AutomationId="AiConfirmPrivacyNotice" />

        </StackPanel>
      </ScrollViewer>

      <!-- Footer Action Buttons: Sửa, Hủy, Xác nhận & thêm vào Google -->
      <Border Padding="24,14"
              Background="{DynamicResource SurfaceMutedBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,1,0,0"
              CornerRadius="{DynamicResource CornerRadiusDialogBottom}">
        <DockPanel LastChildFill="False">
          <!-- Left: Sửa -->
          <Button DockPanel.Dock="Left"
                  Content="{loc:Loc ai_confirm.btn_edit}"
                  Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding EditCommand}"
                  AutomationProperties.AutomationId="BtnAiConfirmEdit" />

          <!-- Right: Hủy & Xác nhận -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="{loc:Loc ai_confirm.btn_cancel}"
                    Style="{StaticResource GhostButtonStyle}"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.AutomationId="BtnAiConfirmCancel" />

            <Button Content="{loc:Loc ai_confirm.btn_confirm}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    IsEnabled="{Binding CanConfirm}"
                    ToolTip="{Binding CanConfirmDisabledReason}"
                    Command="{Binding ConfirmCommand}"
                    AutomationProperties.AutomationId="BtnAiConfirmSubmit" />
          </StackPanel>
        </DockPanel>
      </Border>

    </StackPanel>
  </Border>
</Window>
