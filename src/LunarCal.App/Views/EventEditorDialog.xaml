<Window x:Class="LunarCal.App.Views.EventEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LunarCal.App.ViewModels"
        xmlns:conv="clr-namespace:LunarCal.App.Converters"
        xmlns:loc="clr-namespace:LunarCal.App.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:EventEditorViewModel}"
        Title="{Binding DialogTitle}"
        Width="{DynamicResource EventEditorDialogWidth}"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBackgroundBrush}"
        AutomationProperties.AutomationId="EventEditorDialog">

  <Window.InputBindings>
    <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </Window.InputBindings>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:ColorToBrushConverter x:Key="ColorToBrush" />

    <!-- Form label style -->
    <Style x:Key="FormLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
      <Setter Property="FontWeight" Value="{DynamicResource FontWeightSemiBold}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Form text box style -->
    <Style x:Key="FormTextBox" TargetType="TextBox">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBodyStrong}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="{DynamicResource ThicknessPaddingInput}" />
    </Style>

    <!-- Primary action button -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="{DynamicResource CornerRadiusMedium}"
                    Padding="{DynamicResource ThicknessPaddingButton}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.FontSize="{DynamicResource FontSizeBodyStrong}"
                                TextElement.FontWeight="{DynamicResource FontWeightSemiBold}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Secondary button -->
    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource CornerRadiusMedium}"
                    Padding="{DynamicResource ThicknessPaddingButton}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.FontSize="{DynamicResource FontSizeBodyStrong}"
                                TextElement.FontWeight="{DynamicResource FontWeightMedium}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Danger button -->
    <Style x:Key="DangerButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="{DynamicResource CornerRadiusMedium}"
                    Padding="{DynamicResource ThicknessPaddingButton}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.FontSize="{DynamicResource FontSizeBodyStrong}"
                                TextElement.FontWeight="{DynamicResource FontWeightSemiBold}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Small chip button -->
    <Style x:Key="ChipButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="{DynamicResource ControlTrackBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="{DynamicResource CornerRadiusPill}"
                    Padding="10,4,10,4">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.FontSize="{DynamicResource FontSizeCaption}"
                                TextElement.FontWeight="{DynamicResource FontWeightMedium}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <!-- Header -->
      <RowDefinition Height="Auto" />
      <!-- Form Content -->
      <RowDefinition Height="*" />
      <!-- Error banner -->
      <RowDefinition Height="Auto" />
      <!-- Footer Buttons -->
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Title Bar / Header -->
    <DockPanel Grid.Row="0" Margin="0,0,0,20">
      <TextBlock Text="{Binding DialogTitle}"
                 FontSize="{DynamicResource FontSizeTitle}"
                 FontWeight="{DynamicResource FontWeightBold}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 VerticalAlignment="Center"
                 AutomationProperties.AutomationId="DialogTitleText" />
    </DockPanel>

    <!-- Scrollable Form Body -->
    <ScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,12,0">

        <!-- Title -->
        <TextBlock Text="{loc:Loc common.title}" Style="{StaticResource FormLabel}" />
        <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource FormTextBox}"
                 Margin="0,0,0,16"
                 AutomationProperties.AutomationId="TxtEventTitle" />

        <!-- Target Calendar -->
        <TextBlock Text="{loc:Loc event.calendar}" Style="{StaticResource FormLabel}" />
        <ComboBox ItemsSource="{Binding AvailableCalendars}"
                  SelectedItem="{Binding SelectedCalendar, Mode=TwoWay}"
                  Margin="0,0,0,16"
                  AutomationProperties.AutomationId="CmbCalendarPicker">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:CalendarItemViewModel}">
              <StackPanel Orientation="Horizontal">
                <Border Width="10" Height="10"
                        CornerRadius="{DynamicResource CornerRadiusFull}"
                        Background="{Binding Color, Converter={StaticResource ColorToBrush}}"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center" />
                <TextBlock Text="{Binding Summary}"
                           FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- All Day Toggle -->
        <CheckBox IsChecked="{Binding IsAllDay, Mode=TwoWay}"
                  Content="{loc:Loc calendar.all_day}"
                  FontSize="{DynamicResource FontSizeBody}"
                  Margin="0,0,0,16"
                  AutomationProperties.AutomationId="ChkAllDay" />

        <!-- Dates & Times Grid -->
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Start Date & Time -->
          <StackPanel Grid.Column="0">
            <TextBlock Text="{loc:Loc event.start_time}" Style="{StaticResource FormLabel}" />
            <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay, Converter={StaticResource DateOnlyToDateTimeConverter}}"
                        Margin="0,0,0,6"
                        AutomationProperties.AutomationId="DpStartDate" />
            <TextBox Text="{Binding StartTime, Mode=TwoWay, Converter={StaticResource TimeOnlyToStringConverter}}"
                     Style="{StaticResource FormTextBox}"
                     Visibility="{Binding IsTimed, Converter={StaticResource BoolToVis}}"
                     AutomationProperties.AutomationId="TxtStartTime" />
          </StackPanel>

          <!-- End Date & Time -->
          <StackPanel Grid.Column="2">
            <TextBlock Text="{loc:Loc event.end_time}" Style="{StaticResource FormLabel}" />
            <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay, Converter={StaticResource DateOnlyToDateTimeConverter}}"
                        Margin="0,0,0,6"
                        AutomationProperties.AutomationId="DpEndDate" />
            <TextBox Text="{Binding EndTime, Mode=TwoWay, Converter={StaticResource TimeOnlyToStringConverter}}"
                     Style="{StaticResource FormTextBox}"
                     Visibility="{Binding IsTimed, Converter={StaticResource BoolToVis}}"
                     AutomationProperties.AutomationId="TxtEndTime" />
          </StackPanel>
        </Grid>

        <!-- Lunar Date Display (calculated from Start Date) -->
        <Border Background="{DynamicResource LunarSubtleBrush}"
                CornerRadius="{DynamicResource CornerRadiusMedium}"
                Padding="12,8"
                Margin="0,0,0,16"
                Visibility="{Binding LunarDateText, Converter={StaticResource StringToVis}}">
          <DockPanel>
            <TextBlock Text="{loc:Loc lunar.label}"
                       FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="{DynamicResource FontWeightSemiBold}"
                       Foreground="{DynamicResource LunarTextPrimaryBrush}"
                       DockPanel.Dock="Left"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding LunarDateText}"
                       FontSize="{DynamicResource FontSizeBodyStrong}"
                       FontWeight="{DynamicResource FontWeightMedium}"
                       Foreground="{DynamicResource LunarStrongBrush}"
                       VerticalAlignment="Center"
                       AutomationProperties.AutomationId="TxtLunarDateNotice" />
          </DockPanel>
        </Border>

        <!-- Recurrence selector -->
        <TextBlock Text="{loc:Loc event.recurrence}" Style="{StaticResource FormLabel}" />
        <ComboBox ItemsSource="{Binding RecurrenceOptions}"
                  SelectedItem="{Binding SelectedRecurrenceOption, Mode=TwoWay}"
                  DisplayMemberPath="Label"
                  Margin="0,0,0,16"
                  AutomationProperties.AutomationId="CmbRecurrence" />

        <!-- Lunar Recurrence Options (shown when RecurrenceKind == Lunar) -->
        <Border Background="{DynamicResource SurfaceMutedBrush}"
                CornerRadius="{DynamicResource CornerRadiusMedium}"
                Padding="14"
                Margin="0,0,0,16"
                Visibility="{Binding IsLunarRecurrence, Converter={StaticResource BoolToVis}}"
                AutomationProperties.AutomationId="BoxLunarRecurrenceSettings">
          <StackPanel>
            <TextBlock Text="{loc:Loc lunar_rule.annual_on}"
                       FontSize="{DynamicResource FontSizeBodyStrong}"
                       FontWeight="{DynamicResource FontWeightSemiBold}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,8" />

            <!-- Lunar Day and Month selectors -->
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="{loc:Loc lunar_rule.day}" Style="{StaticResource FormLabel}" />
                <TextBox Text="{Binding LunarDay, Mode=TwoWay}" Style="{StaticResource FormTextBox}" AutomationProperties.AutomationId="TxtLunarDay" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="{loc:Loc lunar_rule.month}" Style="{StaticResource FormLabel}" />
                <TextBox Text="{Binding LunarMonth, Mode=TwoWay}" Style="{StaticResource FormTextBox}" AutomationProperties.AutomationId="TxtLunarMonth" />
              </StackPanel>
            </Grid>

            <!-- Leap month check & sync to Google -->
            <CheckBox IsChecked="{Binding IsLunarLeap, Mode=TwoWay}"
                      Content="{loc:Loc lunar_rule.is_leap}"
                      FontSize="{DynamicResource FontSizeBody}"
                      Margin="0,0,0,8"
                      AutomationProperties.AutomationId="ChkLunarLeap" />

            <CheckBox IsChecked="{Binding SyncToGoogle, Mode=TwoWay}"
                      Content="{loc:Loc lunar_rule.sync_google}"
                      FontSize="{DynamicResource FontSizeBody}"
                      AutomationProperties.AutomationId="ChkSyncToGoogle" />
          </StackPanel>
        </Border>

        <!-- Reminders Section -->
        <TextBlock Text="{loc:Loc reminder.label}" Style="{StaticResource FormLabel}" />
        <WrapPanel Margin="0,0,0,8">
          <ItemsControl ItemsSource="{Binding ReminderChips}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ReminderChipViewModel}">
                <Border Background="{DynamicResource ControlTrackBrush}"
                        CornerRadius="{DynamicResource CornerRadiusPill}"
                        Padding="10,4,8,4"
                        Margin="0,0,8,6">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Label}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextBodyBrush}"
                               VerticalAlignment="Center" />
                    <Button Command="{Binding RemoveCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="6,0,0,0"
                            Cursor="Hand"
                            AutomationProperties.AutomationId="BtnRemoveReminder">
                      <Path Width="8" Height="8"
                            Data="{DynamicResource IconClose32}"
                            Stroke="{DynamicResource TextTertiaryBrush}"
                            StrokeThickness="1.5"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            Stretch="Uniform" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </WrapPanel>

        <!-- Quick add reminder buttons -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
          <Button Content="+ 10m"
                  Command="{Binding AddReminderCommand}"
                  CommandParameter="10"
                  Style="{StaticResource ChipButton}"
                  Margin="0,0,6,0" />
          <Button Content="+ 30m"
                  Command="{Binding AddReminderCommand}"
                  CommandParameter="30"
                  Style="{StaticResource ChipButton}"
                  Margin="0,0,6,0" />
          <Button Content="+ 1h"
                  Command="{Binding AddReminderCommand}"
                  CommandParameter="60"
                  Style="{StaticResource ChipButton}"
                  Margin="0,0,6,0" />
          <Button Content="+ 1d"
                  Command="{Binding AddReminderCommand}"
                  CommandParameter="1440"
                  Style="{StaticResource ChipButton}" />
        </StackPanel>

        <!-- Location -->
        <TextBlock Text="{loc:Loc event.location.placeholder}" Style="{StaticResource FormLabel}" />
        <TextBox Text="{Binding Location, Mode=TwoWay}"
                 Style="{StaticResource FormTextBox}"
                 Margin="0,0,0,16"
                 AutomationProperties.AutomationId="TxtEventLocation" />

        <!-- Description -->
        <TextBlock Text="{loc:Loc event.description.placeholder}" Style="{StaticResource FormLabel}" />
        <TextBox Text="{Binding Description, Mode=TwoWay}"
                 Style="{StaticResource FormTextBox}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="72"
                 Margin="0,0,0,16"
                 AutomationProperties.AutomationId="TxtEventDescription" />
      </StackPanel>
    </ScrollViewer>

    <!-- Error Banner -->
    <Border Grid.Row="2"
            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
            Background="{DynamicResource DangerSubtleBrush}"
            BorderBrush="{DynamicResource DangerBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource CornerRadiusSmall}"
            Padding="12,8"
            Margin="0,0,0,16"
            AutomationProperties.AutomationId="BoxErrorMessage">
      <TextBlock Text="{Binding ErrorMessage}"
                 FontSize="{DynamicResource FontSizeBody}"
                 Foreground="{DynamicResource DangerBrush}"
                 TextWrapping="Wrap" />
    </Border>

    <!-- Footer Actions: Delete (if editing), Cancel, Save -->
    <DockPanel Grid.Row="3" Margin="0,8,0,0">
      <Button DockPanel.Dock="Left"
              Content="{loc:Loc common.delete}"
              Command="{Binding DeleteCommand}"
              Style="{StaticResource DangerButton}"
              Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
              AutomationProperties.AutomationId="BtnDeleteEvent" />

      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{loc:Loc common.cancel}"
                Command="{Binding CancelCommand}"
                Style="{StaticResource SecondaryButton}"
                IsCancel="True"
                Margin="0,0,12,0"
                AutomationProperties.AutomationId="BtnCancelEvent" />
        <Button Content="{loc:Loc common.save}"
                Command="{Binding SaveCommand}"
                Style="{StaticResource PrimaryButton}"
                IsDefault="True"
                AutomationProperties.AutomationId="BtnSaveEvent" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
