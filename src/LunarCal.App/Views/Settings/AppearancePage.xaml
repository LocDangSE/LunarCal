<UserControl x:Class="LunarCal.App.Views.Settings.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LunarCal.App.ViewModels"
             xmlns:loc="clr-namespace:LunarCal.App.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AppearanceSettingsViewModel}"
             AutomationProperties.AutomationId="AppearanceSettingsPage"
             AutomationProperties.Name="{loc:Loc Key=settings.appearance.title}">
  <!-- Figma S13 (23:1966). High contrast follows Windows ("Theo hệ thống"), as the theme subtitle says. The
       "Mật độ" and "Chi tiết âm lịch" rows have no requirement or setting yet (spec §4.3) and are not shown. -->
  <StackPanel>
    <TextBlock Text="{loc:Loc Key=settings.appearance.title}" Style="{StaticResource SettingsSectionTitleStyle}" />
    <TextBlock Text="{loc:Loc Key=settings.appearance.desc}" Style="{StaticResource SettingsSectionDescStyle}" />
    <Border Style="{StaticResource SettingsCardStyle}">
      <Border Style="{StaticResource SettingsLastRowStyle}">
        <DockPanel>
          <Border DockPanel.Dock="Right" Style="{StaticResource SettingsSegmentTrackStyle}">
            <StackPanel Orientation="Horizontal">
              <RadioButton Content="{loc:Loc Key=settings.appearance.theme_light}" GroupName="Theme" Style="{StaticResource SettingsSegmentStyle}"
                           IsChecked="{Binding IsThemeLight, Mode=TwoWay}" AutomationProperties.AutomationId="ThemeRadioLight" />
              <RadioButton Content="{loc:Loc Key=settings.appearance.theme_dark}" GroupName="Theme" Style="{StaticResource SettingsSegmentStyle}"
                           IsChecked="{Binding IsThemeDark, Mode=TwoWay}" AutomationProperties.AutomationId="ThemeRadioDark" />
              <RadioButton Content="{loc:Loc Key=settings.appearance.theme_system}" GroupName="Theme" Style="{StaticResource SettingsSegmentStyle}"
                           IsChecked="{Binding IsThemeSystem, Mode=TwoWay}" AutomationProperties.AutomationId="ThemeRadioSystem" />
            </StackPanel>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{loc:Loc Key=settings.appearance.theme}" Style="{StaticResource SettingsRowTitleStyle}" />
            <TextBlock Text="{loc:Loc Key=settings.appearance.theme_desc}" Style="{StaticResource SettingsRowDescStyle}" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Border>

    <TextBlock Text="{loc:Loc Key=settings.appearance.datetime_title}" Style="{StaticResource SettingsSectionTitleStyle}" />
    <TextBlock Text="{loc:Loc Key=settings.appearance.datetime_desc}" Style="{StaticResource SettingsSectionDescStyle}" />
    <Border Style="{StaticResource SettingsCardStyle}">
      <StackPanel>
        <Border Style="{StaticResource SettingsRowStyle}">
          <DockPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource SettingsSegmentTrackStyle}">
              <StackPanel Orientation="Horizontal">
                <RadioButton Content="{loc:Loc Key=settings.appearance.week_start_monday}" GroupName="WeekStart" Style="{StaticResource SettingsSegmentStyle}"
                             IsChecked="{Binding IsMondayStart, Mode=TwoWay}" AutomationProperties.AutomationId="WeekStartRadioMonday" />
                <RadioButton Content="{loc:Loc Key=settings.appearance.week_start_sunday}" GroupName="WeekStart" Style="{StaticResource SettingsSegmentStyle}"
                             IsChecked="{Binding IsSundayStart, Mode=TwoWay}" AutomationProperties.AutomationId="WeekStartRadioSunday" />
              </StackPanel>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{loc:Loc Key=settings.appearance.week_start}" Style="{StaticResource SettingsRowTitleStyle}" />
              <TextBlock Text="{loc:Loc Key=settings.appearance.week_start_desc}" Style="{StaticResource SettingsRowDescStyle}" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource SettingsRowStyle}">
          <DockPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource SettingsSegmentTrackStyle}">
              <StackPanel Orientation="Horizontal">
                <RadioButton Content="{loc:Loc Key=settings.appearance.time_format_24h}" GroupName="TimeFormat" Style="{StaticResource SettingsSegmentStyle}"
                             IsChecked="{Binding Is24Hours, Mode=TwoWay}" AutomationProperties.AutomationId="TimeFormatRadio24h" />
                <RadioButton Content="{loc:Loc Key=settings.appearance.time_format_12h}" GroupName="TimeFormat" Style="{StaticResource SettingsSegmentStyle}"
                             IsChecked="{Binding Is12Hours, Mode=TwoWay}" AutomationProperties.AutomationId="TimeFormatRadio12h" />
              </StackPanel>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{loc:Loc Key=settings.appearance.time_format}" Style="{StaticResource SettingsRowTitleStyle}" />
              <TextBlock Text="{loc:Loc Key=settings.appearance.time_format_desc}" Style="{StaticResource SettingsRowDescStyle}" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource SettingsLastRowStyle}">
          <DockPanel>
            <ComboBox DockPanel.Dock="Right"
                      ItemsSource="{Binding AvailableTimezones}"
                      SelectedValue="{Binding SelectedTimezone, Mode=TwoWay}"
                      SelectedValuePath="Id"
                      DisplayMemberPath="DisplayName"
                      MaxWidth="340"
                      MaxDropDownHeight="360"
                      Style="{StaticResource InlineDropdownStyle}"
                      AutomationProperties.AutomationId="TimezoneComboBox"
                      AutomationProperties.Name="{loc:Loc Key=settings.appearance.timezone}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{loc:Loc Key=settings.appearance.timezone}" Style="{StaticResource SettingsRowTitleStyle}" />
              <TextBlock Text="{loc:Loc Key=settings.appearance.timezone_desc}" Style="{StaticResource SettingsRowDescStyle}" />
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </Border>

    <TextBlock Text="{Binding SaveErrorText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
               FontSize="{DynamicResource FontSizeBody}" />
  </StackPanel>
</UserControl>
