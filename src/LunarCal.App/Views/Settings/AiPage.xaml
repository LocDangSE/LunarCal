<UserControl x:Class="LunarCal.App.Views.Settings.AiPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LunarCal.App.ViewModels"
             xmlns:conv="clr-namespace:LunarCal.App.Converters"
             xmlns:loc="clr-namespace:LunarCal.App.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AiSettingsViewModel}"
             AutomationProperties.AutomationId="AiSettingsPage">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringToVis" />

    <Style x:Key="PrivacyNoticeBoxStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ControlTrackBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMedium}" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="StatusBannerBoxStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMedium}" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Margin" Value="0,14,0,0" />
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <!-- Section 1: Gemini API Key (Figma 04, FR-BYOK-1..4) -->
    <TextBlock Text="{loc:Loc Key=settings.ai.title}" Style="{StaticResource SettingsSectionTitleStyle}" />
    <TextBlock Text="{loc:Loc Key=settings.ai.desc}" Style="{StaticResource SettingsSectionDescStyle}" />

    <!-- Key Card Container -->
    <Border Style="{StaticResource SettingsCardStyle}" Margin="0,12,0,16">
      <StackPanel>
        <!-- Row 1: Privacy Notice & AI Studio link -->
        <Border Style="{StaticResource SettingsRowStyle}">
          <StackPanel>
            <Border Style="{StaticResource PrivacyNoticeBoxStyle}">
              <TextBlock Text="{loc:Loc Key=settings.ai.privacy_notice}"
                         TextWrapping="Wrap"
                         FontSize="{DynamicResource FontSizeBody}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         LineHeight="20" />
            </Border>

            <Button Content="{loc:Loc Key=settings.ai.get_key_link}"
                    Command="{Binding OpenAiStudioCommand}"
                    Style="{StaticResource LinkButtonStyle}"
                    HorizontalAlignment="Left"
                    FontSize="{DynamicResource FontSizeBodyStrong}"
                    Foreground="{DynamicResource AccentPrimaryBrush}"
                    AutomationProperties.AutomationId="BtnOpenAiStudio" />
          </StackPanel>
        </Border>

        <!-- Row 2: Saved Key State (HasKey && !IsEditing) -->
        <Border Visibility="{Binding HasKey, Converter={StaticResource BoolToVis}}">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource SettingsLastRowStyle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <DockPanel LastChildFill="False">
            <!-- Action buttons on the right -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="{loc:Loc Key=settings.ai.change_key}"
                      Command="{Binding StartEditingCommand}"
                      Style="{StaticResource SecondaryButtonStyle}"
                      Margin="0,0,10,0"
                      AutomationProperties.AutomationId="BtnChangeKey" />

              <Button Content="{loc:Loc Key=settings.ai.delete_key}"
                      Command="{Binding DeleteKeyCommand}"
                      Style="{StaticResource DangerButtonStyle}"
                      Margin="0,0,10,0"
                      AutomationProperties.AutomationId="BtnDeleteKey" />

              <Button Content="{loc:Loc Key=settings.ai.suspect_leaked}"
                      Command="{Binding SuspectLeakedCommand}"
                      Style="{StaticResource DangerButtonStyle}"
                      AutomationProperties.AutomationId="BtnSuspectLeaked" />
            </StackPanel>

            <!-- Key display on the left -->
            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{loc:Loc Key=settings.ai.status_saved}"
                           Margin="8,0,0,0"
                           FontSize="{DynamicResource FontSizeBodyStrong}"
                           FontWeight="{DynamicResource FontWeightSemiBold}"
                           Foreground="{DynamicResource SuccessTextBrush}" />
              </StackPanel>
              <TextBlock Text="{Binding MaskedKey}"
                         FontFamily="Consolas, Segoe UI Variable, Segoe UI"
                         FontSize="{DynamicResource FontSizeSubtitle}"
                         FontWeight="{DynamicResource FontWeightSemiBold}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         AutomationProperties.AutomationId="TxtMaskedKey" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Row 3: Input Mode (!HasKey || IsEditing) -->
        <Border>
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource SettingsLastRowStyle}">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasKey}" Value="True" />
                    <Condition Binding="{Binding IsEditing}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel>
            <TextBlock Text="{loc:Loc Key=settings.ai.key_label}"
                       FontSize="{DynamicResource FontSizeSubtitle}"
                       FontWeight="{DynamicResource FontWeightSemiBold}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,8" />

            <!-- PasswordBox: cleared immediately after reading, never bound directly (SEC-KEY-9) -->
            <PasswordBox x:Name="KeyPasswordBox"
                         Height="38"
                         FontSize="{DynamicResource FontSizeBodyStrong}"
                         Padding="10,8"
                         VerticalContentAlignment="Center"
                         BorderBrush="{DynamicResource BorderStrongBrush}"
                         BorderThickness="1"
                         Background="{DynamicResource SurfaceBackgroundBrush}"
                         AutomationProperties.AutomationId="PbGeminiApiKey" />

            <DockPanel Margin="0,14,0,0" LastChildFill="False">
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="BtnSaveKey"
                        Content="{loc:Loc Key=settings.ai.check_and_save}"
                        Click="OnCheckAndSaveClicked"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="{Binding IsChecking, Converter={StaticResource InverseBool}}"
                        AutomationProperties.AutomationId="BtnSaveKey" />

                <Button x:Name="BtnSaveOffline"
                        Content="{loc:Loc Key=settings.ai.save_offline}"
                        Click="OnSaveOfflineClicked"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="10,0,0,0"
                        IsEnabled="{Binding IsChecking, Converter={StaticResource InverseBool}}"
                        Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.AutomationId="BtnSaveOffline" />

                <Button Content="{loc:Loc Key=common.cancel}"
                        Command="{Binding CancelEditingCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="10,0,0,0"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.AutomationId="BtnCancelEditing" />
              </StackPanel>

              <!-- Progress text -->
              <TextBlock DockPanel.Dock="Right"
                         Text="{loc:Loc Key=settings.ai.checking}"
                         VerticalAlignment="Center"
                         FontSize="{DynamicResource FontSizeBody}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />
            </DockPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- Feedback Banners -->
    <!-- Status message banner -->
    <Border Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource StatusBannerBoxStyle}">
          <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
          <Setter Property="BorderThickness" Value="1" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
              <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
              <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="{Binding StatusMessage}"
                 TextWrapping="Wrap"
                 FontSize="{DynamicResource FontSizeBodyStrong}"
                 AutomationProperties.AutomationId="TxtAiStatusMessage">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Border>

    <!-- Clipboard cleared notice (SEC-KEY-10) -->
    <Border Style="{StaticResource StatusBannerBoxStyle}"
            Background="{DynamicResource SurfaceMutedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Visibility="{Binding IsClipboardCleared, Converter={StaticResource BoolToVis}}">
      <StackPanel Orientation="Horizontal">
        <Path Width="14" Height="14" Data="{DynamicResource IconCheck14}"
              Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{loc:Loc Key=settings.ai.clipboard_cleared}"
                   Margin="8,0,0,0"
                   FontSize="{DynamicResource FontSizeBody}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center"
                   AutomationProperties.AutomationId="TxtClipboardClearedNotice" />
      </StackPanel>
    </Border>

    <!-- Suspect leaked guide (SEC-KEY-7) -->
    <Border Style="{StaticResource StatusBannerBoxStyle}"
            Background="{DynamicResource DangerSubtleBrush}"
            BorderBrush="{DynamicResource DangerBrush}"
            BorderThickness="1"
            Visibility="{Binding IsSuspectLeaked, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <TextBlock Text="{loc:Loc Key=settings.ai.suspect_leaked_title}"
                   FontSize="{DynamicResource FontSizeSubtitle}"
                   FontWeight="{DynamicResource FontWeightSemiBold}"
                   Foreground="{DynamicResource DangerBrush}"
                   Margin="0,0,0,6" />
        <TextBlock Text="{loc:Loc Key=settings.ai.suspect_leaked_guide}"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeBody}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   LineHeight="20"
                   AutomationProperties.AutomationId="TxtSuspectLeakedGuide" />
      </StackPanel>
    </Border>

    <!-- Section 2: Model Selection (FR-BYOK-5, ADR-0016 §2) -->
    <TextBlock Text="{loc:Loc Key=settings.ai.models_title}" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0,24,0,0" />
    <TextBlock Text="{loc:Loc Key=settings.ai.models_desc}" Style="{StaticResource SettingsSectionDescStyle}" />

    <Border Style="{StaticResource SettingsCardStyle}" Margin="0,12,0,16">
      <StackPanel>
        <Border Style="{StaticResource SettingsRowStyle}">
          <DockPanel>
            <Button DockPanel.Dock="Right"
                    Content="{loc:Loc Key=settings.ai.model_refresh}"
                    Command="{Binding RefreshModelsCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="16,0,0,0"
                    IsEnabled="{Binding IsLoadingModels, Converter={StaticResource InverseBool}}"
                    AutomationProperties.AutomationId="BtnRefreshModels" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{loc:Loc Key=settings.ai.model_select_label}" Style="{StaticResource SettingsRowTitleStyle}" />
              <TextBlock Text="{Binding SelectedModel.DisplayName, FallbackValue='gemini-3.8-flash'}" Style="{StaticResource SettingsRowDescStyle}"
                         AutomationProperties.AutomationId="TxtActiveModelDisplay" />
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Style="{StaticResource SettingsLastRowStyle}">
          <StackPanel>
            <ComboBox ItemsSource="{Binding AvailableModels}"
                      SelectedItem="{Binding SelectedModel, Mode=OneWay}"
                      SelectionChanged="OnModelSelectionChanged"
                      Height="38"
                      FontSize="{DynamicResource FontSizeBody}"
                      Background="{DynamicResource SurfaceBackgroundBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderStrongBrush}"
                      AutomationProperties.AutomationId="CbAiModelSelect">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="4,2">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="{DynamicResource FontWeightSemiBold}" />
                    <TextBlock Text=" · " Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding Id}" FontFamily="Consolas, Segoe UI Variable" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="{DynamicResource CornerRadiusCheckbox}" Padding="6,2" Margin="8,0,0,0"
                            Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="{loc:Loc Key=settings.ai.model_default_tag}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource AccentPrimaryBrush}" />
                    </Border>
                    <Border Background="{DynamicResource SuccessSubtleBrush}" CornerRadius="{DynamicResource CornerRadiusCheckbox}" Padding="6,2" Margin="4,0,0,0"
                            Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="{loc:Loc Key=settings.ai.model_recommended_tag}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource SuccessTextBrush}" />
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Validating / Status indicator -->
            <TextBlock Text="{loc:Loc Key=settings.ai.model_validating}"
                       Margin="0,8,0,0"
                       FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="{Binding IsValidatingModel, Converter={StaticResource BoolToVis}}"
                       AutomationProperties.AutomationId="TxtModelValidating" />

            <TextBlock Text="{Binding ModelStatusMessage}"
                       Margin="0,8,0,0"
                       FontSize="{DynamicResource FontSizeBody}"
                       TextWrapping="Wrap"
                       Visibility="{Binding ModelStatusMessage, Converter={StaticResource StringToVis}}"
                       AutomationProperties.AutomationId="TxtModelStatusMessage">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsModelStatusError}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- Section 3: Cost, Quota & Privacy (FR-BYOK-5, ADR-0016 §3) -->
    <TextBlock Text="{loc:Loc Key=settings.ai.pricing_title}" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0,16,0,0" />
    <Border Style="{StaticResource SettingsCardStyle}" Margin="0,12,0,24">
      <StackPanel Margin="16,14">
        <TextBlock Text="{loc:Loc Key=settings.ai.quota_notice}"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeBody}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,0,0,10"
                   AutomationProperties.AutomationId="TxtAiQuotaNotice" />
        <TextBlock Text="{loc:Loc Key=settings.ai.free_tier_notice}"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeBody}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,0,0,10"
                   AutomationProperties.AutomationId="TxtAiFreeTierNotice" />
        <TextBlock Text="{loc:Loc Key=settings.ai.pricing_notice}"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeBody}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   AutomationProperties.AutomationId="TxtAiPricingNotice" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
