<UserControl x:Class="LunarCal.App.Views.Settings.AdvancedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LunarCal.App.ViewModels"
             xmlns:conv="clr-namespace:LunarCal.App.Converters"
             xmlns:loc="clr-namespace:LunarCal.App.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             AutomationProperties.AutomationId="AdvancedSettingsPage">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringToVis" />
  </UserControl.Resources>

  <!-- Figma S20 (34:191). "Model Gemini" (34:372) arrives with the Gemini client in P4-02. -->
  <StackPanel>
    <!-- Messages for the actions on this page -->
    <TextBlock Text="{Binding Advanced.StatusMessage}" Margin="0,0,0,12" TextWrapping="Wrap"
               FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource SuccessTextBrush}"
               Visibility="{Binding Advanced.StatusMessage, Converter={StaticResource StringToVis}}"
               AutomationProperties.AutomationId="AdvancedStatusText" />
    <TextBlock Text="{Binding Advanced.ErrorMessage}" Margin="0,0,0,12" TextWrapping="Wrap"
               FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource DangerBrush}"
               Visibility="{Binding Advanced.ErrorMessage, Converter={StaticResource StringToVis}}"
               AutomationProperties.AutomationId="AdvancedErrorText" />

    <!-- Section · Tài khoản Google (34:318). Several accounts arrive with FR-AUTH-5; one account for now. -->
    <TextBlock Text="{loc:Loc Key=settings.account.title}" Style="{StaticResource SettingsSectionTitleStyle}" />
    <TextBlock Text="{loc:Loc Key=settings.advanced.accounts_desc}" Style="{StaticResource SettingsSectionDescStyle}" />
    <Border Style="{StaticResource SettingsCardStyle}">
      <StackPanel>
        <Border Style="{StaticResource SettingsRowStyle}" Visibility="{Binding Account.IsSignedIn, Converter={StaticResource BoolToVis}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{loc:Loc Key=settings.advanced.signout}" Command="{Binding Account.SignOutCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" Margin="16,0,0,0" AutomationProperties.AutomationId="BtnAdvancedSignOut" />
            <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="{DynamicResource CornerRadiusFull}"
                    Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="{Binding Account.AccountInitials}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         FontSize="{DynamicResource FontSizeBody}" FontWeight="{DynamicResource FontWeightSemiBold}"
                         Foreground="{DynamicResource OnAccentBrush}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Account.AccountDisplayName}" Style="{StaticResource SettingsRowTitleStyle}" />
              <TextBlock Style="{StaticResource SettingsRowDescStyle}">
                <Run Text="{Binding Account.AccountEmail, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Account.LastSyncText, Mode=OneWay}" />
              </TextBlock>
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource SettingsLastRowStyle}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Command="{Binding Account.SignInCommand}" Style="{StaticResource PrimaryButtonStyle}"
                    Content="{Binding Account.SignInButtonText}"
                    AutomationProperties.AutomationId="BtnChangeAccount" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{loc:Loc Key=settings.advanced.change_account_title}" Style="{StaticResource SettingsRowTitleStyle}" />
              <TextBlock Text="{loc:Loc Key=settings.advanced.change_account_desc}" Style="{StaticResource SettingsRowDescStyle}" />
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- Section · OAuth client (34:354) — FR-AUTH-6 -->
    <TextBlock Text="{loc:Loc Key=settings.advanced.oauth_title}" Style="{StaticResource SettingsSectionTitleStyle}" />
    <TextBlock Text="{loc:Loc Key=settings.advanced.oauth_desc}" Style="{StaticResource SettingsSectionDescStyle}" />
    <Border Style="{StaticResource SettingsCardStyle}">
      <StackPanel>
        <Border Style="{StaticResource SettingsRowStyle}">
          <DockPanel>
            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Advanced.UseCustomClient, Mode=TwoWay}"
                      AutomationProperties.AutomationId="UseCustomClientToggle"
                      AutomationProperties.Name="{loc:Loc Key=settings.advanced.custom_client}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{loc:Loc Key=settings.advanced.custom_client}" Style="{StaticResource SettingsRowTitleStyle}" />
              <TextBlock Text="{loc:Loc Key=settings.advanced.custom_client_desc}" Style="{StaticResource SettingsRowDescStyle}" />
            </StackPanel>
          </DockPanel>
        </Border>
        <StackPanel Margin="18,16" Visibility="{Binding Advanced.UseCustomClient, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="{loc:Loc Key=settings.advanced.client_id}" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding Advanced.ClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextFieldStyle}"
                   AutomationProperties.AutomationId="TxtClientId" AutomationProperties.Name="{loc:Loc Key=settings.advanced.client_id}" />
          <TextBlock Text="{loc:Loc Key=settings.advanced.client_id_help}" Style="{StaticResource FieldHelpStyle}" />

          <TextBlock Text="{loc:Loc Key=settings.advanced.client_secret}" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6" />
          <!-- Masked secret with "Hiện"/"Ẩn" (S20 34:191); the stored secret is never loaded back -->
          <Grid>
            <PasswordBox x:Name="SecretBox" Style="{StaticResource PasswordFieldStyle}" Padding="12,9,64,9"
                         PasswordChanged="OnSecretChanged"
                         AutomationProperties.AutomationId="TxtClientSecret" AutomationProperties.Name="{loc:Loc Key=settings.advanced.client_secret}" />
            <TextBox x:Name="SecretPlain" Style="{StaticResource TextFieldStyle}" Padding="12,9,64,9" Visibility="Collapsed"
                     TextChanged="OnPlainSecretChanged"
                     AutomationProperties.AutomationId="TxtClientSecretPlain" AutomationProperties.Name="{loc:Loc Key=settings.advanced.client_secret}" />
            <Button x:Name="BtnRevealSecret" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,12,0" FontSize="{DynamicResource FontSizeBody}" FontWeight="{DynamicResource FontWeightRegular}"
                    Foreground="{DynamicResource TextSecondaryBrush}" Content="{loc:Loc Key=common.show}" Click="OnRevealSecret"
                    AutomationProperties.AutomationId="BtnRevealSecret" />
          </Grid>
          <TextBlock Text="{loc:Loc Key=settings.advanced.client_secret_stored}" Style="{StaticResource FieldHelpStyle}"
                     Visibility="{Binding Advanced.HasStoredSecret, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{loc:Loc Key=settings.advanced.client_secret_help}" Style="{StaticResource FieldHelpStyle}" />

          <Border Style="{StaticResource InfoBannerStyle}" Margin="0,14,0,14">
            <DockPanel>
              <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
              <StackPanel>
                <TextBlock Text="{loc:Loc Key=settings.account.testing_title}" FontSize="{DynamicResource FontSizeBodyStrong}"
                           FontWeight="{DynamicResource FontWeightSemiBold}" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Loc Key=settings.account.testing_warning}" Margin="0,2,0,0" FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource TextBodyBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
          </Border>

          <StackPanel Orientation="Horizontal">
            <Button Content="{loc:Loc Key=settings.advanced.save_oauth}" Command="{Binding Advanced.SaveOAuthCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" AutomationProperties.AutomationId="BtnSaveOAuth" />
            <Button Content="{loc:Loc Key=settings.advanced.use_default_client}" Command="{Binding Advanced.UseDefaultClientCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="BtnUseDefaultClient" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Section · Model Gemini (34:372) — FR-BYOK-5, ADR-0016 -->
    <TextBlock Text="{loc:Loc Key=settings.advanced.gemini_model_title}" Style="{StaticResource SettingsSectionTitleStyle}" />
    <TextBlock Text="{loc:Loc Key=settings.advanced.gemini_model_desc}" Style="{StaticResource SettingsSectionDescStyle}" />
    <Border Style="{StaticResource SettingsCardStyle}">
      <StackPanel>
        <Border Style="{StaticResource SettingsLastRowStyle}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Ai.SelectedModel.Id, FallbackValue='gemini-3.8-flash'}"
                       FontFamily="Consolas, Segoe UI Variable" FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="AdvancedModelIdText" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Ai.SelectedModel.DisplayName, FallbackValue='Gemini 3.8 Flash'}" Style="{StaticResource SettingsRowTitleStyle}"
                         AutomationProperties.AutomationId="AdvancedModelDisplayNameText" />
              <TextBlock Text="{loc:Loc Key=settings.ai.models_desc}" Style="{StaticResource SettingsRowDescStyle}" />
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- Section · Dữ liệu trên máy (34:393) — SEC-DATA-1..3 -->
    <TextBlock Text="{loc:Loc Key=settings.advanced.data_title}" Style="{StaticResource SettingsSectionTitleStyle}" />
    <TextBlock Text="{loc:Loc Key=settings.advanced.data_desc}" Style="{StaticResource SettingsSectionDescStyle}" />
    <Border Style="{StaticResource SettingsCardStyle}">
      <StackPanel>
        <Border Style="{StaticResource SettingsRowStyle}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{loc:Loc Key=settings.advanced.open_folder}" Command="{Binding Advanced.OpenDataFolderCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="BtnOpenDataFolder" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{loc:Loc Key=settings.advanced.data_location}" Style="{StaticResource SettingsRowTitleStyle}" />
              <TextBlock Text="{Binding Advanced.DataLocationText}" Style="{StaticResource SettingsRowDescStyle}" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource SettingsRowStyle}">
          <StackPanel>
            <TextBlock Text="{loc:Loc Key=settings.advanced.data_size}" Style="{StaticResource SettingsRowTitleStyle}" />
            <TextBlock Text="{Binding Advanced.StorageSizeText}" Style="{StaticResource SettingsRowDescStyle}" AutomationProperties.AutomationId="StorageSizeText" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsLastRowStyle}" Background="{DynamicResource DangerRowBrush}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{loc:Loc Key=settings.advanced.wipe_button}" Command="{Binding Advanced.WipeAllDataCommand}"
                    Style="{StaticResource DangerButtonStyle}" IsEnabled="{Binding Advanced.IsWiping, Converter={StaticResource InverseBool}}"
                    AutomationProperties.AutomationId="BtnWipeData" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{loc:Loc Key=settings.advanced.wipe_title}" Style="{StaticResource SettingsRowTitleStyle}" />
              <TextBlock Text="{loc:Loc Key=settings.advanced.wipe_desc}" Style="{StaticResource SettingsRowDescStyle}" />
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- Section · Nhật ký (34:413) — SEC-LOG-1 -->
    <TextBlock Text="{loc:Loc Key=settings.advanced.logs_title}" Style="{StaticResource SettingsSectionTitleStyle}" />
    <TextBlock Text="{loc:Loc Key=settings.advanced.logs_desc}" Style="{StaticResource SettingsSectionDescStyle}" />
    <Border Style="{StaticResource SettingsCardStyle}">
      <StackPanel>
        <Border Style="{StaticResource SettingsRowStyle}">
          <DockPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource SettingsSegmentTrackStyle}">
              <StackPanel Orientation="Horizontal">
                <RadioButton Content="{loc:Loc Key=settings.advanced.log_info}" GroupName="LogLevel" Style="{StaticResource SettingsSegmentStyle}"
                             IsChecked="{Binding Advanced.IsDebugLogging, Mode=TwoWay, Converter={StaticResource InverseBool}}"
                             AutomationProperties.AutomationId="LogLevelInfo" />
                <RadioButton Content="{loc:Loc Key=settings.advanced.log_debug}" GroupName="LogLevel" Style="{StaticResource SettingsSegmentStyle}"
                             IsChecked="{Binding Advanced.IsDebugLogging, Mode=TwoWay}" AutomationProperties.AutomationId="LogLevelDebug" />
              </StackPanel>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{loc:Loc Key=settings.advanced.log_level}" Style="{StaticResource SettingsRowTitleStyle}" />
              <TextBlock Text="{loc:Loc Key=settings.advanced.log_level_desc}" Style="{StaticResource SettingsRowDescStyle}" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource SettingsLastRowStyle}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{loc:Loc Key=settings.advanced.open_folder}" Command="{Binding Advanced.OpenLogsFolderCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="BtnOpenLogs" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{loc:Loc Key=settings.advanced.logs_folder}" Style="{StaticResource SettingsRowTitleStyle}" />
              <TextBlock Text="{loc:Loc Key=settings.advanced.logs_folder_desc}" Style="{StaticResource SettingsRowDescStyle}" />
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
