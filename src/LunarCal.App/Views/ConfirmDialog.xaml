<Window x:Class="LunarCal.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LunarCal.App.Localization"
        Title="{Binding Title}"
        Width="{DynamicResource ConfirmDialogWidth}"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource FontFamilyBase}"
        AutomationProperties.AutomationId="ConfirmDialog">
  <!-- Same dialog chrome as S10 (35:774): white card, radius 14, border, dialog shadow. -->
  <Border Margin="24"
          Background="{DynamicResource SurfaceBackgroundBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="{DynamicResource CornerRadiusAiCard}"
          Effect="{DynamicResource ShadowDialog}">
    <StackPanel Margin="24,22,24,20">
      <TextBlock Text="{Binding Title}"
                 FontSize="{DynamicResource FontSizePanelTitle}"
                 FontWeight="{DynamicResource FontWeightSemiBold}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 TextWrapping="Wrap"
                 AutomationProperties.AutomationId="ConfirmTitle" />
      <TextBlock Text="{Binding Message}"
                 Margin="0,10,0,22"
                 FontSize="{DynamicResource FontSizeBodyStrong}"
                 Foreground="{DynamicResource TextBodyBrush}"
                 TextWrapping="Wrap"
                 AutomationProperties.AutomationId="ConfirmMessage" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{loc:Loc Key=common.cancel}"
                Style="{StaticResource SecondaryButtonStyle}"
                IsCancel="True"
                IsDefault="True"
                Click="OnCancel"
                Margin="0,0,8,0"
                AutomationProperties.AutomationId="BtnConfirmCancel" />
        <Button x:Name="ConfirmButton"
                Content="{Binding ConfirmText}"
                Click="OnConfirm"
                AutomationProperties.AutomationId="BtnConfirmOk" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
