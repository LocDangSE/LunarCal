<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Dark Theme Color Palette -->

  <!-- Backgrounds & Surfaces -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#18191B" />
  <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#222428" />
  <SolidColorBrush x:Key="SurfaceElevatedBackgroundBrush" Color="#2C2E33" />
  <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#1E2024" />
  <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#222428" />
  <SolidColorBrush x:Key="ControlTrackBrush" Color="#2D3036" />
  <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#353840" />

  <!-- Borders -->
  <SolidColorBrush x:Key="BorderBrush" Color="#373A40" />
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#2D3036" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#4B505A" />

  <!-- Typography -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F4F7" />
  <SolidColorBrush x:Key="TextBodyBrush" Color="#D0D5DD" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#98A2B3" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#667085" />
  <SolidColorBrush x:Key="TextDisabledBrush" Color="#4B505A" />

  <!-- Accents & Actions -->
  <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#4E83FF" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#6B99FF" />
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1E2D4A" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="#8AB4F8" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

  <!-- Calendar Day Highlights -->
  <SolidColorBrush x:Key="TodayHighlightBrush" Color="#4E83FF" />
  <SolidColorBrush x:Key="TodayBackgroundBrush" Color="#1E2D4A" />
  <SolidColorBrush x:Key="SelectedDayBackgroundBrush" Color="#233558" />

  <!-- Lunar Calendar -->
  <SolidColorBrush x:Key="LunarTextPrimaryBrush" Color="#F79009" />
  <SolidColorBrush x:Key="LunarTextSecondaryBrush" Color="#98A2B3" />
  <SolidColorBrush x:Key="LunarSubtleBrush" Color="#38230D" />
  <SolidColorBrush x:Key="LunarStrongBrush" Color="#FFB366" />

  <!-- AI Elements -->
  <SolidColorBrush x:Key="AiAccentBrush" Color="#9B8AFB" />
  <SolidColorBrush x:Key="AiSubtleBrush" Color="#2B2347" />
  <SolidColorBrush x:Key="AiTextBrush" Color="#BDB4FE" />

  <!-- Status & Feedback -->
  <SolidColorBrush x:Key="DangerBrush" Color="#F04438" />
  <SolidColorBrush x:Key="DangerSubtleBrush" Color="#381615" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#32D583" />
  <SolidColorBrush x:Key="SuccessTextBrush" Color="#6CE9A6" />
  <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#0D3322" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FEC84B" />
  <SolidColorBrush x:Key="WarningTextBrush" Color="#FEDF89" />
  <SolidColorBrush x:Key="WarningSubtleBrush" Color="#3E2C08" />
  <SolidColorBrush x:Key="NowLineBrush" Color="#F04438" />
  <SolidColorBrush x:Key="ScrimBrush" Color="#A6000000" />

</ResourceDictionary>
