<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Dark Theme Color Palette (Figma 01-05 & spec §4.3) -->

  <!-- Backgrounds -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202124" />
  <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#292A2D" />
  <SolidColorBrush x:Key="SurfaceElevatedBackgroundBrush" Color="#303134" />
  <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#292A2D" />
  <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#35363A" />

  <!-- Borders -->
  <SolidColorBrush x:Key="BorderBrush" Color="#3C4043" />
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#4A4D51" />

  <!-- Typography -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8EAED" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA0A6" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#80868B" />

  <!-- Accents & Actions -->
  <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#8AB4F8" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#AECBFA" />
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="#394457" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="#202124" />

  <!-- Calendar Day Highlights -->
  <SolidColorBrush x:Key="TodayHighlightBrush" Color="#8AB4F8" />
  <SolidColorBrush x:Key="TodayBackgroundBrush" Color="#394457" />
  <SolidColorBrush x:Key="SelectedDayBackgroundBrush" Color="#253550" />

  <!-- Lunar Text -->
  <SolidColorBrush x:Key="LunarTextPrimaryBrush" Color="#F28B82" />
  <SolidColorBrush x:Key="LunarTextSecondaryBrush" Color="#9AA0A6" />

  <!-- Status Feedback -->
  <SolidColorBrush x:Key="DangerBrush" Color="#F28B82" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#81C995" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FDD663" />

</ResourceDictionary>
