<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Light Theme Color Palette (Figma 01-05 & .agents/rules/ui.md) -->

  <!-- Backgrounds & Surfaces -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F6F7F9" />
  <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SurfaceElevatedBackgroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F9FAFB" />
  <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ControlTrackBrush" Color="#F2F4F7" />
  <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#F2F4F7" />

  <!-- Borders -->
  <SolidColorBrush x:Key="BorderBrush" Color="#EAECF0" />
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#EAECF0" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#D0D5DD" />

  <!-- Typography -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#101828" />
  <SolidColorBrush x:Key="TextBodyBrush" Color="#344054" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#667085" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#98A2B3" />
  <SolidColorBrush x:Key="TextDisabledBrush" Color="#D0D5DD" />

  <!-- Accents & Actions -->
  <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#2F6BFF" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="#EAF1FF" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="#1D4ED8" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

  <!-- Calendar Day Highlights -->
  <SolidColorBrush x:Key="TodayHighlightBrush" Color="#2F6BFF" />
  <SolidColorBrush x:Key="TodayBackgroundBrush" Color="#EAF1FF" />
  <SolidColorBrush x:Key="SelectedDayBackgroundBrush" Color="#EAF1FF" />

  <!-- Lunar Calendar -->
  <SolidColorBrush x:Key="LunarTextPrimaryBrush" Color="#B54708" />
  <SolidColorBrush x:Key="LunarTextSecondaryBrush" Color="#667085" />
  <SolidColorBrush x:Key="LunarSubtleBrush" Color="#FFF4E5" />
  <SolidColorBrush x:Key="LunarStrongBrush" Color="#93370D" />

  <!-- AI Elements -->
  <SolidColorBrush x:Key="AiAccentBrush" Color="#7A5AF8" />
  <SolidColorBrush x:Key="AiSubtleBrush" Color="#FAF8FF" />
  <SolidColorBrush x:Key="AiTextBrush" Color="#5925DC" />

  <!-- Status & Feedback -->
  <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
  <SolidColorBrush x:Key="DangerSubtleBrush" Color="#FEF3F2" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#12B76A" />
  <SolidColorBrush x:Key="SuccessTextBrush" Color="#067647" />
  <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#ECFDF3" />
  <SolidColorBrush x:Key="WarningBrush" Color="#F79009" />
  <SolidColorBrush x:Key="WarningTextBrush" Color="#B54708" />
  <SolidColorBrush x:Key="WarningSubtleBrush" Color="#FFFAEB" />
  <SolidColorBrush x:Key="OnWarningBrush" Color="#101828" />
  <SolidColorBrush x:Key="NowLineBrush" Color="#F04438" />
  <SolidColorBrush x:Key="ScrimBrush" Color="#73101828" />

</ResourceDictionary>
