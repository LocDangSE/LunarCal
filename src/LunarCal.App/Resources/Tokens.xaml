<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Typography: Families (Inter with Segoe UI fallback) -->
  <FontFamily x:Key="FontFamilyBase">Inter, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif</FontFamily>
  <!-- Icon font (P2-R10): Segoe Fluent Icons on Windows 11, Segoe MDL2 Assets on Windows 10 (same code points) -->
  <FontFamily x:Key="FontFamilyIcon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="FontFamilyMonospace">Cascadia Code, Consolas, Courier New, monospace</FontFamily>

  <!-- Typography: Sizes (measured from Figma 01-05 & .agents/rules/ui.md) -->
  <sys:Double x:Key="FontSizeDisplay">24</sys:Double>
  <!-- First run wizard step title (S14 39:280, P3-R3) -->
  <sys:Double x:Key="FontSizeWizardTitle">22</sys:Double>
  <sys:Double x:Key="FontSizeTitle">20</sys:Double>
  <sys:Double x:Key="FontSizeSection">16</sys:Double>
  <sys:Double x:Key="FontSizeSubtitle">14</sys:Double>
  <sys:Double x:Key="FontSizeBodyStrong">13</sys:Double>
  <sys:Double x:Key="FontSizeBody">12</sys:Double>
  <sys:Double x:Key="FontSizeCaption">11</sys:Double>
  <sys:Double x:Key="FontSizeMini">9.5</sys:Double>
  <sys:Double x:Key="FontSizeBadge">10</sys:Double>
  <sys:Double x:Key="FontSizeLunarHero">40</sys:Double>
  <!-- Figma 01, S06-S09 sizes (P2-R11..R15) -->
  <sys:Double x:Key="FontSizeBrand">19</sys:Double>
  <sys:Double x:Key="FontSizeColumnDate">17</sys:Double>
  <sys:Double x:Key="FontSizeDialogTitle">17</sys:Double>
  <sys:Double x:Key="FontSizeAgendaDate">18</sys:Double>
  <sys:Double x:Key="FontSizePanelTitle">18</sys:Double>
  <sys:Double x:Key="FontSizeLunarBlock">36</sys:Double>

  <!-- Icon glyph sizes for emoji/symbol glyphs (P2-R5; values unchanged from the Phase 2 views) -->
  <sys:Double x:Key="IconSizeSmall">14</sys:Double>
  <sys:Double x:Key="IconSizeMedium">16</sys:Double>
  <sys:Double x:Key="IconSizeLarge">20</sys:Double>
  <sys:Double x:Key="IconSizeXLarge">24</sys:Double>
  <sys:Double x:Key="IconSizeEmptyState">36</sys:Double>

  <!-- Icon glyphs in FontFamilyIcon for icons Figma has not drawn yet (empty states). Do not use emoji or arrow characters as icons. -->
  <sys:String x:Key="IconGlyphCalendar">&#xE787;</sys:String>

  <!-- Figma icon paths (P2-R11..R15), copied from the exported SVG of each icon node. Coordinates are in the icon's
       own box (the number in the key), so draw them with Stretch="None" inside a box of that size. -->
  <Geometry x:Key="IconPlus16">M8 3.33333V8M8 8V12.6667M8 8H3.33333M8 8H12.6667</Geometry>
  <Geometry x:Key="IconArrowRight16">M3 8H13M9 4L13 8L9 12</Geometry>
  <Geometry x:Key="IconChevronDown16">M4 6L8 10L12 6</Geometry>
  <Geometry x:Key="IconChevronLeft16">M10 12L6 8L10 4</Geometry>
  <Geometry x:Key="IconChevronRight16">M6 12L10 8L6 4</Geometry>
  <Geometry x:Key="IconChevronLeft18">M11.25 13.5L6.75 9L11.25 4.5</Geometry>
  <Geometry x:Key="IconChevronRight18">M6.75 13.5L11.25 9L6.75 4.5</Geometry>
  <Geometry x:Key="IconCheck11">M9.16667 2.75L4.125 7.79167L1.83333 5.5</Geometry>
  <Geometry x:Key="IconSend16">M14.6667 1.33333L7.33333 8.66667M7.33333 8.66667L1.33333 6L14.6667 1.33333L10 14.6667L7.33333 8.66667Z</Geometry>
  <Geometry x:Key="IconClose32">M11 11L16 16M16 16L21 21M16 16L21 11M16 16L11 21</Geometry>
  <Geometry x:Key="IconSparkle10">M5 0.833333L6.08333 3.91667L9.16667 5L6.08333 6.08333L5 9.16667L3.91667 6.08333L0.833333 5L3.91667 3.91667L5 0.833333Z</Geometry>
  <Geometry x:Key="IconSparkle18">M9 1.5L10.95 7.05L16.5 9L10.95 10.95L9 16.5L7.05 10.95L1.5 9L7.05 7.05L9 1.5Z</Geometry>
  <Geometry x:Key="IconSparkle20">M10 1.66667L12.1667 7.83333L18.3333 10L12.1667 12.1667L10 18.3333L7.83333 12.1667L1.66667 10L7.83333 7.83333L10 1.66667Z</Geometry>
  <Geometry x:Key="IconRefresh16">M14 8C14.0013 9.37403 13.5309 10.7069 12.6675 11.7757C11.804 12.8446 10.5999 13.5848 9.25634 13.8725C7.91277 14.1602 6.51115 13.978 5.28575 13.3564C4.06035 12.7349 3.08541 11.7115 2.52389 10.4575C1.96238 9.2034 1.84829 7.79461 2.20072 6.46654C2.55314 5.13847 3.35072 3.9716 4.46014 3.16095C5.56957 2.3503 6.92361 1.945 8.29597 2.01278C9.66834 2.08055 10.9759 2.61731 12 3.53333L14 5.33333M10.6667 5.33333H14V2</Geometry>

  <!-- Figma shadows (x, y, blur, colour). WPF DropShadowEffect: Direction 270 = downwards, 0 = right. -->
  <DropShadowEffect x:Key="ShadowAccentButton" Color="#2F6BFF" Opacity="0.2" BlurRadius="20" ShadowDepth="8" Direction="270" />
  <DropShadowEffect x:Key="ShadowAiInput" Color="#7A5AF8" Opacity="0.2" BlurRadius="24" ShadowDepth="8" Direction="270" />
  <DropShadowEffect x:Key="ShadowAiSend" Color="#7A5AF8" Opacity="0.4" BlurRadius="20" ShadowDepth="8" Direction="270" />
  <DropShadowEffect x:Key="ShadowSidebar" Color="#101828" Opacity="0.04" BlurRadius="16" ShadowDepth="4" Direction="0" />
  <DropShadowEffect x:Key="ShadowTopBar" Color="#101828" Opacity="0.03" BlurRadius="12" ShadowDepth="4" Direction="270" />
  <DropShadowEffect x:Key="ShadowDialog" Color="#0F1729" Opacity="0.25" BlurRadius="50" ShadowDepth="20" Direction="270" />

  <!-- Typography: Weights -->
  <FontWeight x:Key="FontWeightRegular">Normal</FontWeight>
  <FontWeight x:Key="FontWeightMedium">Medium</FontWeight>
  <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
  <FontWeight x:Key="FontWeightBold">Bold</FontWeight>

  <!-- Spacing (Double scalars) -->
  <sys:Double x:Key="SpacingXxs">2</sys:Double>
  <sys:Double x:Key="SpacingXs">4</sys:Double>
  <sys:Double x:Key="SpacingSm">8</sys:Double>
  <sys:Double x:Key="SpacingGap10">10</sys:Double>
  <sys:Double x:Key="SpacingMd">12</sys:Double>
  <sys:Double x:Key="SpacingLg">16</sys:Double>
  <sys:Double x:Key="SpacingXl">24</sys:Double>
  <sys:Double x:Key="SpacingXxl">32</sys:Double>

  <!-- Thickness: Margins / Paddings (Figma 01-05) -->
  <Thickness x:Key="ThicknessPaddingSmall">4</Thickness>
  <Thickness x:Key="ThicknessPaddingMedium">8</Thickness>
  <Thickness x:Key="ThicknessPaddingLarge">12</Thickness>
  <Thickness x:Key="ThicknessPaddingXLarge">16</Thickness>
  <Thickness x:Key="ThicknessPaddingButton">14,9,14,9</Thickness>
  <Thickness x:Key="ThicknessPaddingSegmented">14,6,14,6</Thickness>
  <Thickness x:Key="ThicknessPaddingInput">14,10,14,10</Thickness>
  <Thickness x:Key="ThicknessPaddingMonthCell">8,8,6,8</Thickness>
  <Thickness x:Key="ThicknessPaddingEventChip">6,3,6,3</Thickness>
  <Thickness x:Key="ThicknessBorderThin">1</Thickness>
  <Thickness x:Key="ThicknessBorderMedium">2</Thickness>

  <!-- Corner Radius (Figma 01-05) -->
  <CornerRadius x:Key="CornerRadiusSmall">5</CornerRadius>
  <CornerRadius x:Key="CornerRadiusMedium">8</CornerRadius>
  <CornerRadius x:Key="CornerRadiusLarge">12</CornerRadius>
  <CornerRadius x:Key="CornerRadiusAiCard">14</CornerRadius>
  <CornerRadius x:Key="CornerRadiusDialog">16</CornerRadius>
  <CornerRadius x:Key="CornerRadiusDialogBottom">0,0,16,16</CornerRadius>
  <CornerRadius x:Key="CornerRadiusDayNumber">13</CornerRadius>
  <!-- Circles only (equal width and height). WPF scales radii that exceed the size, so 999 on a wide box draws an ellipse. -->
  <CornerRadius x:Key="CornerRadiusFull">999</CornerRadius>
  <!-- Pills: chips about 24 px high (Online chip, filter chips, count badge) -->
  <CornerRadius x:Key="CornerRadiusPill">12</CornerRadius>
  <!-- Checkbox square (Figma 01 calendar list) -->
  <CornerRadius x:Key="CornerRadiusCheckbox">4</CornerRadius>
  <CornerRadius x:Key="CornerRadiusStripe">2</CornerRadius>
  <CornerRadius x:Key="CornerRadiusLogo">9</CornerRadius>
  <CornerRadius x:Key="CornerRadiusSegment">7</CornerRadius>
  <CornerRadius x:Key="CornerRadiusSegmentTrack">9</CornerRadius>
  <CornerRadius x:Key="CornerRadiusEventBlock">6</CornerRadius>
  <CornerRadius x:Key="CornerRadiusListItem">10</CornerRadius>
  <CornerRadius x:Key="CornerRadiusAiBar">24</CornerRadius>

  <!-- Layout Metrics (Figma 01-05 & .agents/rules/ui.md) -->
  <sys:Double x:Key="TopBarHeight">64</sys:Double>
  <sys:Double x:Key="SidebarWidth">280</sys:Double>
  <sys:Double x:Key="MiniCalendarCellSize">28</sys:Double>
  <sys:Double x:Key="AiCommandBarHeight">92</sys:Double>
  <!-- Input box inside the 92 px command bar (Figma 01: 59 px high, 16 px margin above and below) -->
  <sys:Double x:Key="AiCommandInputHeight">59</sys:Double>
  <sys:Double x:Key="WeekdayHeaderHeight">36</sys:Double>
  <GridLength x:Key="WeekdayHeaderGridHeight">36</GridLength>
  <sys:Double x:Key="DayDetailPanelWidth">360</sys:Double>
  <sys:Double x:Key="HourRowHeight">48</sys:Double>
  <sys:Double x:Key="HourColumnWidth">56</sys:Double>
  <GridLength x:Key="HourGutterGridWidth">56</GridLength>
  <!-- 24 × 48 px hours plus 8 px above the first line and below the last one (Figma S06 24:60) -->
  <sys:Double x:Key="TimeGridHeight">1168</sys:Double>
  <!-- Event Editor Dialog (Figma S10 35:774) -->
  <sys:Double x:Key="EventEditorDialogWidth">560</sys:Double>
  <sys:Double x:Key="ConfirmDialogWidth">488</sys:Double>
  <!-- Figma S14 1.5 (52:3130): card 520 wide plus 24 margin each side for the shadow -->
  <sys:Double x:Key="AccountSwitchDialogWidth">568</sys:Double>
  <sys:Double x:Key="SettingsContentWidth">720</sys:Double>
  <sys:Double x:Key="SettingsNavItemHeight">42</sys:Double>

</ResourceDictionary>
