<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(LunarCalWindowsTfm)</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>LunarCal.App</RootNamespace>
    <AssemblyName>LunarCal</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UserSecretsId>46e39089-41b1-4007-b05e-a5eeb4624b12</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LunarCal.Infrastructure\LunarCal.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- Non-secret configuration only (spec §11). -->
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LunarCal.App.UiTests" />
    <InternalsVisibleTo Include="LunarCal.App.Tests" />
  </ItemGroup>

</Project>
