{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "LunarCal": {
    "Google": {
      "OAuthClientId": "",
      "LoopbackTimeoutSeconds": 300
    },
    "Gemini": {
      "BaseUrl": "https://generativelanguage.googleapis.com/",
      "DefaultModelId": "",
      "RequestTimeoutSeconds": 60
    },
    "Sync": {
      "WindowMonthsBack": 12,
      "WindowMonthsAhead": 24,
      "PollingActiveMinutes": 2,
      "PollingTrayMinutes": 10,
      "MaxRequestsPerSecond": 5
    },
    "Chat": {
      "MaxBulkEvents": 500,
      "MaxToolCallsPerSession": 50,
      "MaxMessageLength": 4000,
      "AutoConfirmSingleEvent": false
    },
    "Confirm": {
      "ClearThresholdPercent": 90,
      "ReviewThresholdPercent": 60
    },
    "AiQueue": {
      "MaxRetries": 5,
      "RetentionDays": 30
    },
    "Lunar": {
      "DefaultYearsAhead": 5,
      "MaxYearsAhead": 20
    },
    "DataLake": {
      "RootPath": "%LOCALAPPDATA%/LunarCal/datalake"
    },
    "Cloud": {
      "IngestionBaseUrl": "",
      "UploadBatchMaxRecords": 100,
      "UploadBatchMaxBytes": 1048576
    },
    "Network": {
      "AllowedHosts": [
        "*.googleapis.com",
        "accounts.google.com",
        "oauth2.googleapis.com",
        "generativelanguage.googleapis.com"
      ]
    }
  }
}
