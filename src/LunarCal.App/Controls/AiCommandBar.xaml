<UserControl x:Class="LunarCal.App.Controls.AiCommandBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:LunarCal.App.Localization"
             xmlns:vm="clr-namespace:LunarCal.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AiCommandBarViewModel}"
             Focusable="False">

  <UserControl.Resources>
    <!-- Circular send button template matching Figma 01 (1:491) -->
    <Style x:Key="AiSendButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Width="36" Height="36">
              <Border Background="{DynamicResource AiAccentBrush}"
                      CornerRadius="{DynamicResource CornerRadiusFull}"
                      Effect="{DynamicResource ShadowAiSend}" />
              <Path Width="16" Height="16"
                    Data="{DynamicResource IconSend16}"
                    Stroke="{DynamicResource OnAccentBrush}"
                    StrokeThickness="1.33333"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    Stretch="None"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.9" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <!-- AI Command Bar Container (Figma 1:198, FR-UI-5): 92 px bar with rounded input card and optional offline banner -->
  <Grid Background="{DynamicResource WindowBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Offline notification banner above command input (FR-QUEUE-3) -->
    <Border Grid.Row="0"
            Background="{DynamicResource WarningSubtleBrush}"
            BorderBrush="{DynamicResource WarningBorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource CornerRadiusMedium}"
            Padding="12,6"
            Margin="24,4,24,0"
            AutomationProperties.AutomationId="AiOfflineBanner">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsOfflineBannerVisible}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right"
                Command="{Binding DismissOfflineBannerCommand}"
                Background="Transparent"
                BorderThickness="0"
                Padding="4"
                Cursor="Hand"
                Margin="8,0,0,0"
                AutomationProperties.AutomationId="BtnDismissAiOfflineBanner">
          <Path Data="{DynamicResource IconClose32}"
                Stroke="{DynamicResource WarningTextBrush}"
                StrokeThickness="1.5"
                Width="12" Height="12" />
        </Button>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock Text="{loc:Loc Key=ai.offline_banner}"
                     FontSize="{DynamicResource FontSizeCaption}"
                     FontWeight="{DynamicResource FontWeightMedium}"
                     Foreground="{DynamicResource WarningTextBrush}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Main Command Input Box (Figma 1:198: 59 px high inside 92 px bar) -->
    <Grid Grid.Row="1" Height="{DynamicResource AiCommandBarHeight}" VerticalAlignment="Center">
      <Border Margin="24,16,24,17"
              Background="{DynamicResource SurfaceBackgroundBrush}"
              BorderBrush="{DynamicResource AiBorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource CornerRadiusAiBar}"
              Height="{DynamicResource AiCommandInputHeight}"
              Padding="16,8,8,8"
              Effect="{DynamicResource ShadowAiInput}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Sparkle icon (Figma 1:203) -->
          <Path Grid.Column="0"
                Data="{DynamicResource IconSparkle20}"
                Fill="{DynamicResource AiAccentBrush}"
                Stretch="None"
                VerticalAlignment="Center"
                Margin="0,0,12,0" />

          <!-- Command text input with placeholder watermark -->
          <Grid Grid.Column="1" VerticalAlignment="Center">
            <!-- Watermark placeholder -->
            <TextBlock Text="{loc:Loc Key=ai.command_placeholder}"
                       FontSize="{DynamicResource FontSizeSubtitle}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CommandText}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding CommandText}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <!-- Input TextBox -->
            <TextBox x:Name="CommandTextBox"
                     Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="{DynamicResource FontSizeSubtitle}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     CaretBrush="{DynamicResource AiAccentBrush}"
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalAlignment="Center"
                     KeyDown="OnCommandTextBoxKeyDown"
                     AutomationProperties.AutomationId="AiCommandInput"
                     AutomationProperties.Name="{loc:Loc Key=ai.command_placeholder}" />
          </Grid>

          <!-- Language detection chip: VI · EN (Figma 1:490) -->
          <Border Grid.Column="2"
                  Background="{DynamicResource AiChipBrush}"
                  BorderBrush="{DynamicResource AiBorderSubtleBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource CornerRadiusPill}"
                  Padding="10,4"
                  Margin="0,0,12,0"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding DetectedLanguage}"
                       FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="{DynamicResource FontWeightSemiBold}"
                       Foreground="{DynamicResource AiTextBrush}" />
          </Border>

          <!-- Submit button (Figma 1:491) -->
          <Button Grid.Column="3"
                  Command="{Binding SendCommandCommand}"
                  Style="{StaticResource AiSendButtonStyle}"
                  AutomationProperties.AutomationId="BtnAiSubmit"
                  AutomationProperties.Name="{loc:Loc Key=ai_queue.action_confirm}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
