<UserControl x:Class="LunarCal.App.Controls.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LunarCal.App.ViewModels"
             xmlns:loc="clr-namespace:LunarCal.App.Localization"
             xmlns:conv="clr-namespace:LunarCal.App.Converters"
             xmlns:controls="clr-namespace:LunarCal.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
             Width="{DynamicResource SidebarWidth}"
             AutomationProperties.AutomationId="Sidebar">

  <!-- Figma 01 sidebar (1:3): white, right border #E4E7EC, shadow (4,0,16) 4%, padding 20/16/16/16, gap 20. -->
  <UserControl.Resources>
    <conv:ColorToBrushConverter x:Key="ColorToBrush" />

    <!-- Button/Tạo sự kiện (1:9): accent, radius 8, padding 9/14, plus icon 16 + 13 SemiBold white, glow shadow -->
    <Style x:Key="CreateEventButtonStyle" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Background="{DynamicResource AccentPrimaryBrush}"
                      CornerRadius="{DynamicResource CornerRadiusMedium}"
                      Effect="{DynamicResource ShadowAccentButton}" />
              <Border x:Name="btnBorder"
                      Background="{DynamicResource AccentPrimaryBrush}"
                      CornerRadius="{DynamicResource CornerRadiusMedium}"
                      Padding="{DynamicResource ThicknessPaddingButton}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Path Width="16" Height="16"
                        Data="{DynamicResource IconPlus16}"
                        Stroke="{DynamicResource OnAccentBrush}"
                        StrokeThickness="1.33333"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        Stretch="None"
                        VerticalAlignment="Center" />
                  <ContentPresenter Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    TextElement.Foreground="{DynamicResource OnAccentBrush}"
                                    TextElement.FontSize="{DynamicResource FontSizeBodyStrong}"
                                    TextElement.FontWeight="{DynamicResource FontWeightSemiBold}" />
                </StackPanel>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Calendar list item (1:170): 16 px square checkbox in the calendar colour, radius 4, white check 11 px;
         label 13 Regular #344054, gap 10 -->
    <Style x:Key="CalendarCheckBoxStyle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box"
                      Width="16" Height="16"
                      CornerRadius="{DynamicResource CornerRadiusCheckbox}"
                      Background="{Binding Color, Converter={StaticResource ColorToBrush}}"
                      BorderBrush="{Binding Color, Converter={StaticResource ColorToBrush}}"
                      BorderThickness="1.5"
                      VerticalAlignment="Center">
                <Path x:Name="checkMark"
                      Width="11" Height="11"
                      Data="{DynamicResource IconCheck11}"
                      Stroke="{DynamicResource OnAccentBrush}"
                      StrokeThickness="1.375"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stretch="None" />
              </Border>
              <ContentPresenter Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                TextElement.FontSize="{DynamicResource FontSizeBodyStrong}"
                                TextElement.Foreground="{DynamicResource TextBodyBrush}" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="False">
                <Setter TargetName="checkMark" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="box" Property="Background" Value="Transparent" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <!-- Background + right border; the shadow layer stays behind so it does not blur content -->
    <Border Background="{DynamicResource SidebarBackgroundBrush}" Effect="{DynamicResource ShadowSidebar}" />
    <Border Background="{DynamicResource SidebarBackgroundBrush}"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="0,0,1,0" />

    <Grid Margin="16,20,16,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Logo (1:4): 34 px accent tile radius 9 with an 18 px sparkle, "LunarCal" 19 Bold -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
        <Border Width="34" Height="34"
                Background="{DynamicResource AccentPrimaryBrush}"
                CornerRadius="{DynamicResource CornerRadiusLogo}">
          <Path Width="18" Height="18"
                Data="{DynamicResource IconSparkle18}"
                Fill="{DynamicResource OnAccentBrush}"
                Stretch="None" />
        </Border>
        <TextBlock Text="LunarCal"
                   Margin="10,0,0,0"
                   FontSize="{DynamicResource FontSizeBrand}"
                   FontWeight="{DynamicResource FontWeightBold}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   VerticalAlignment="Center" />
      </StackPanel>

      <!-- Create event (FR-UI-10) -->
      <Button Grid.Row="1"
              Content="{loc:Loc Key=sidebar.create_event}"
              Command="{Binding CreateEventCommand}"
              Style="{StaticResource CreateEventButtonStyle}"
              AutomationProperties.AutomationId="BtnCreateEvent"
              AutomationProperties.Name="{loc:Loc Key=sidebar.create_event}"
              Margin="0,0,0,20" />

      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <controls:MiniCalendar DataContext="{Binding MiniCalendar}" Margin="0,0,0,14" />

          <!-- My calendars (1:168): header 11 SemiBold tertiary uppercase, items gap 10 -->
          <TextBlock Text="{loc:Loc Key=sidebar.my_calendars}"
                     FontSize="{DynamicResource FontSizeCaption}"
                     FontWeight="{DynamicResource FontWeightSemiBold}"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     Margin="0,0,0,10" />

          <ItemsControl ItemsSource="{Binding Calendars}" AutomationProperties.AutomationId="CalendarList" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox Content="{Binding Summary}"
                          IsChecked="{Binding IsSelected}"
                          Style="{StaticResource CalendarCheckBoxStyle}"
                          Margin="0,0,0,10"
                          AutomationProperties.Name="{Binding Summary}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- Sync status (1:191): muted card, border, radius 12, padding 12, gap 8; click to sync now -->
      <Button Grid.Row="3"
              Margin="0,20,0,0"
              Command="{Binding SyncNowCommand}"
              Cursor="Hand"
              ToolTip="{loc:Loc Key=sidebar.sync_now}"
              AutomationProperties.AutomationId="SyncStatusBlock"
              AutomationProperties.Name="{loc:Loc Key=sidebar.sync_now}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusLarge}"
                    Padding="12">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Button.Template>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                      <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{loc:Loc Key=sidebar.sync_title}"
                       Margin="8,0,0,0"
                       FontSize="{DynamicResource FontSizeBody}"
                       FontWeight="{DynamicResource FontWeightMedium}"
                       Foreground="{DynamicResource TextBodyBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding SyncDetailText}"
                     Margin="0,8,0,0"
                     FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     AutomationProperties.AutomationId="SyncDetailText" />
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
</UserControl>
