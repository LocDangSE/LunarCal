<UserControl x:Class="LunarCal.App.Controls.MiniCalendar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LunarCal.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LunarCal.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MiniCalendarViewModel}"
             AutomationProperties.AutomationId="MiniCalendar">

  <!-- Figma 01 mini calendar (1:13): header 14 SemiBold, weekday row 22 px, day rows 28 px with a 26 px circle. -->
  <UserControl.Resources>
    <!-- Chevron button with no chrome (Figma icon/l, icon/r: 16 px, #667085) -->
    <Style x:Key="MiniNavButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent">
              <Path Width="16" Height="16"
                    Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                    Stroke="{DynamicResource TextSecondaryBrush}"
                    StrokeThickness="1.33333"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Stretch="None" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MiniDayButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="28" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="dayCircle"
                      Width="26" Height="26"
                      CornerRadius="{DynamicResource CornerRadiusFull}"
                      Background="Transparent">
                <TextBlock x:Name="dayText"
                           Text="{Binding DayNumber}"
                           FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource TextBodyBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                <Setter TargetName="dayText" Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="dayCircle" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
              </Trigger>
              <DataTrigger Binding="{Binding IsToday}" Value="True">
                <Setter TargetName="dayText" Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                <Setter TargetName="dayText" Property="FontWeight" Value="{DynamicResource FontWeightSemiBold}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="dayCircle" Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                <Setter TargetName="dayText" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                <Setter TargetName="dayText" Property="FontWeight" Value="{DynamicResource FontWeightSemiBold}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <!-- Header: "Tháng 10, 2026" + chevrons (gap 8) -->
    <Grid Margin="0,0,0,6">
      <TextBlock Text="{Binding MonthTitle}"
                 FontSize="{DynamicResource FontSizeSubtitle}"
                 FontWeight="{DynamicResource FontWeightSemiBold}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 VerticalAlignment="Center"
                 AutomationProperties.AutomationId="MiniMonthTitle" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Style="{StaticResource MiniNavButtonStyle}"
                Content="{DynamicResource IconChevronLeft16}"
                Command="{Binding PreviousMonthCommand}"
                ToolTip="{loc:Loc Key=minical.prev_month}"
                AutomationProperties.AutomationId="MiniPrevMonth"
                AutomationProperties.Name="{loc:Loc Key=minical.prev_month}" />
        <Button Style="{StaticResource MiniNavButtonStyle}"
                Content="{DynamicResource IconChevronRight16}"
                Command="{Binding NextMonthCommand}"
                ToolTip="{loc:Loc Key=minical.next_month}"
                Margin="8,0,0,0"
                AutomationProperties.AutomationId="MiniNextMonth"
                AutomationProperties.Name="{loc:Loc Key=minical.next_month}" />
      </StackPanel>
    </Grid>

    <!-- Weekday row (T2 … CN): 22 px, 11 Medium, tertiary -->
    <ItemsControl ItemsSource="{Binding DayHeaders}" Margin="0,0,0,6" Focusable="False">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="7" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Height="22">
            <TextBlock Text="{Binding}"
                       FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="{DynamicResource FontWeightMedium}"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- 6×7 days; Figma rows are 28 px apart with a 6 px gap -->
    <ItemsControl ItemsSource="{Binding Days}" x:Name="MiniDaysGrid" Focusable="False">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="7" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Style="{StaticResource MiniDayButtonStyle}"
                  Margin="0,0,0,6"
                  Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  CommandParameter="{Binding}"
                  AutomationProperties.Name="{Binding AccessibleName}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
