<UserControl x:Class="LunarCal.App.Controls.TopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LunarCal.App.ViewModels"
             xmlns:loc="clr-namespace:LunarCal.App.Localization"
             xmlns:conv="clr-namespace:LunarCal.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
             Height="{DynamicResource TopBarHeight}"
             AutomationProperties.AutomationId="TopBar">

  <!-- Figma 01 top bar (1:197): white, bottom border #E4E7EC, padding 0/24, gap 14. -->
  <UserControl.Resources>
    <conv:EnumToBooleanConverter x:Key="EnumToBool" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Button/Hôm nay (1:198): white, border #D0D5DD, radius 8, padding 9/14, 13 SemiBold #344054 -->
    <Style x:Key="OutlineButtonStyle" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="border"
                    Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusMedium}"
                    Padding="{DynamicResource ThicknessPaddingButton}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.FontSize="{DynamicResource FontSizeBodyStrong}"
                                TextElement.FontWeight="{DynamicResource FontWeightSemiBold}"
                                TextElement.Foreground="{DynamicResource TextBodyBrush}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- nav (1:200): 32 px circle, border #E4E7EC, chevron 18 px #475467 stroke 1.5 -->
    <Style x:Key="NavIconButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="border"
                    Width="32" Height="32"
                    Background="Transparent"
                    BorderBrush="{DynamicResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusFull}">
              <Path Width="18" Height="18"
                    Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                    Stroke="{DynamicResource TextSecondaryStrongBrush}"
                    StrokeThickness="1.5"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Stretch="None" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- View switch item (1:211): padding 6/14, radius 7; checked = white, 13 SemiBold #101828; else 13 Medium #667085 -->
    <Style x:Key="SegmentedRadioButtonStyle" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="border"
                    Background="Transparent"
                    CornerRadius="{DynamicResource CornerRadiusSegment}"
                    Padding="{DynamicResource ThicknessPaddingSegmented}"
                    Margin="0,0,2,0">
              <ContentPresenter x:Name="content"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.FontSize="{DynamicResource FontSizeBodyStrong}"
                                TextElement.FontWeight="{DynamicResource FontWeightMedium}"
                                TextElement.Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
                <Setter TargetName="content" Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter TargetName="content" Property="TextElement.FontWeight" Value="{DynamicResource FontWeightSemiBold}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Language item (1:220): padding 6/10, radius 7, 12 SemiBold; active = accent fill + white text -->
    <Style x:Key="LanguageButtonStyle" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="border"
                    Background="Transparent"
                    CornerRadius="{DynamicResource CornerRadiusSegment}"
                    Padding="10,6"
                    Margin="0,0,2,0">
              <ContentPresenter x:Name="content"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.FontSize="{DynamicResource FontSizeBody}"
                                TextElement.FontWeight="{DynamicResource FontWeightSemiBold}"
                                TextElement.Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
              </Trigger>
              <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                <Setter TargetName="content" Property="TextElement.Foreground" Value="{DynamicResource OnAccentBrush}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Segmented track (1:210, 1:219): #F2F4F7, border #E4E7EC, radius 9, padding 3 -->
    <Style x:Key="SegmentTrackStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ControlTrackBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSegmentTrack}" />
      <Setter Property="Padding" Value="3,3,1,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Border Background="{DynamicResource SurfaceBackgroundBrush}" Effect="{DynamicResource ShadowTopBar}" />
    <Border Background="{DynamicResource SurfaceBackgroundBrush}"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="0,0,0,1" />

    <Grid Margin="24,0">
      <!-- Left group shrinks (title trims) so the right group always stays visible on narrow windows -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0" VerticalAlignment="Center" LastChildFill="True" Margin="0,0,14,0">
        <Button DockPanel.Dock="Left"
                Content="{loc:Loc Key=topbar.today}"
                Command="{Binding GoToTodayCommand}"
                Style="{StaticResource OutlineButtonStyle}"
                AutomationProperties.AutomationId="BtnToday"
                AutomationProperties.Name="{loc:Loc Key=topbar.today}" />

        <Button DockPanel.Dock="Left"
                Content="{DynamicResource IconChevronLeft18}"
                Command="{Binding PreviousPeriodCommand}"
                Style="{StaticResource NavIconButtonStyle}"
                Margin="14,0,0,0"
                AutomationProperties.AutomationId="BtnPrev"
                AutomationProperties.Name="{loc:Loc Key=topbar.prev}"
                ToolTip="{loc:Loc Key=topbar.prev}" />
        <Button DockPanel.Dock="Left"
                Content="{DynamicResource IconChevronRight18}"
                Command="{Binding NextPeriodCommand}"
                Style="{StaticResource NavIconButtonStyle}"
                Margin="14,0,0,0"
                AutomationProperties.AutomationId="BtnNext"
                AutomationProperties.Name="{loc:Loc Key=topbar.next}"
                ToolTip="{loc:Loc Key=topbar.next}" />

        <!-- Title (1:206): 20 Bold + 12 Regular lunar, gap 2 -->
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding HeaderTitle}"
                     FontSize="{DynamicResource FontSizeTitle}"
                     FontWeight="{DynamicResource FontWeightBold}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     TextTrimming="CharacterEllipsis"
                     AutomationProperties.AutomationId="HeaderTitleText" />
          <TextBlock Text="{Binding LunarHeaderSubtitle}"
                     Margin="0,2,0,0"
                     FontSize="{DynamicResource FontSizeBody}"
                     Foreground="{DynamicResource LunarTextPrimaryBrush}"
                     TextTrimming="CharacterEllipsis"
                     Visibility="{Binding IsLunarVisible, Converter={StaticResource BoolToVis}}"
                     AutomationProperties.AutomationId="LunarHeaderSubtitleText" />
        </StackPanel>
      </DockPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <!-- View switch (FR-UI-1) -->
        <Border Style="{StaticResource SegmentTrackStyle}">
          <StackPanel Orientation="Horizontal" AutomationProperties.AutomationId="ViewSwitcher">
            <RadioButton Content="{loc:Loc Key=view.day}"
                         GroupName="ViewModeGroup"
                         IsChecked="{Binding ActiveViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=Day}"
                         Command="{Binding ChangeViewCommand}"
                         CommandParameter="{x:Static vm:CalendarViewMode.Day}"
                         AutomationProperties.AutomationId="ViewModeDay"
                         Style="{StaticResource SegmentedRadioButtonStyle}" />
            <RadioButton Content="{loc:Loc Key=view.week}"
                         GroupName="ViewModeGroup"
                         IsChecked="{Binding ActiveViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=Week}"
                         Command="{Binding ChangeViewCommand}"
                         CommandParameter="{x:Static vm:CalendarViewMode.Week}"
                         AutomationProperties.AutomationId="ViewModeWeek"
                         Style="{StaticResource SegmentedRadioButtonStyle}" />
            <RadioButton Content="{loc:Loc Key=view.month}"
                         GroupName="ViewModeGroup"
                         IsChecked="{Binding ActiveViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=Month}"
                         Command="{Binding ChangeViewCommand}"
                         CommandParameter="{x:Static vm:CalendarViewMode.Month}"
                         AutomationProperties.AutomationId="ViewModeMonth"
                         Style="{StaticResource SegmentedRadioButtonStyle}" />
            <RadioButton Content="{loc:Loc Key=view.agenda}"
                         GroupName="ViewModeGroup"
                         IsChecked="{Binding ActiveViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=Agenda}"
                         Command="{Binding ChangeViewCommand}"
                         CommandParameter="{x:Static vm:CalendarViewMode.Agenda}"
                         AutomationProperties.AutomationId="ViewModeAgenda"
                         Style="{StaticResource SegmentedRadioButtonStyle}" />
          </StackPanel>
        </Border>

        <!-- Language (FR-UI-9) -->
        <Border Style="{StaticResource SegmentTrackStyle}" Margin="14,0,0,0" AutomationProperties.AutomationId="LanguageSwitcher">
          <StackPanel Orientation="Horizontal">
            <Button Content="VI"
                    Tag="{Binding IsVietnameseActive}"
                    Command="{Binding SwitchLanguageCommand}"
                    CommandParameter="vi-VN"
                    Style="{StaticResource LanguageButtonStyle}"
                    AutomationProperties.AutomationId="BtnLangVi"
                    AutomationProperties.Name="Tiếng Việt" />
            <Button Content="EN"
                    Tag="{Binding IsEnglishActive}"
                    Command="{Binding SwitchLanguageCommand}"
                    CommandParameter="en-US"
                    Style="{StaticResource LanguageButtonStyle}"
                    AutomationProperties.AutomationId="BtnLangEn"
                    AutomationProperties.Name="English" />
          </StackPanel>
        </Border>

        <!-- Sync chip (1:224): pill, padding 6/10, dot 8, 12 Medium -->
        <Border Margin="14,0,0,0"
                BorderThickness="1"
                CornerRadius="{DynamicResource CornerRadiusPill}"
                Padding="10,6"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="NetworkStatusChip">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}" />
              <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                  <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource WarningSubtleBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                      <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding NetworkStatusText}"
                       Margin="6,0,0,0"
                       FontSize="{DynamicResource FontSizeBody}"
                       FontWeight="{DynamicResource FontWeightMedium}"
                       VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                      <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- Avatar (1:227): 36 px circle, #EEF2FF, 13 SemiBold #444CE7. Opens Settings (S13); Figma has no
             separate settings button in the top bar. -->
        <Button Margin="14,0,0,0"
                Command="{Binding OpenSettingsCommand}"
                Cursor="Hand"
                ToolTip="{loc:Loc Key=topbar.settings}"
                AutomationProperties.AutomationId="BtnSettings"
                AutomationProperties.Name="{loc:Loc Key=topbar.settings}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border Width="36" Height="36"
                      CornerRadius="{DynamicResource CornerRadiusFull}"
                      Background="{DynamicResource AvatarBackgroundBrush}"
                      AutomationProperties.AutomationId="UserAvatar">
                <TextBlock Text="{Binding UserInitials}"
                           FontSize="{DynamicResource FontSizeBodyStrong}"
                           FontWeight="{DynamicResource FontWeightSemiBold}"
                           Foreground="{DynamicResource AvatarTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
