# Line endings: CRLF for Windows sources (.editorconfig), LF where Linux tools read the file.
* text=auto
*.cs      text eol=crlf
*.xaml    text eol=crlf
*.csproj  text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf
*.slnx    text eol=crlf
*.resx    text eol=crlf
*.ps1     text eol=crlf
*.md      text eol=crlf
*.json    text eol=crlf
*.yml     text eol=crlf
*.yaml    text eol=crlf
*.toml    text eol=crlf
*.csv     text eol=crlf
*.txt     text eol=crlf
*.sh      text eol=lf
Dockerfile    text eol=lf
.dockerignore text eol=lf

# Binary
*.png  binary
*.ico  binary
*.jpg  binary
*.gif  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.parquet binary
*.db   binary
